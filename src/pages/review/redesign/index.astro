---
import * as AstroAssets from 'astro:assets';
import '../../../styles/global.css';

const heroMedia = {
	poster: '/assets/home/project-creativa.jpeg',
	alt: 'CREATIVA project image used as provisional AL MASA redesign layout-test media',
	videoSrc: undefined as string | undefined,
	videoType: 'video/mp4',
	label: 'Provisional layout-test media: CREATIVA project image — not Al Alphy.',
};

const featuredProjects = [
	{
		name: '6-October Insurance Building',
		image: '/assets/home/project-october.png',
		imageAlt: '6-October Insurance Building project image',
		location: '6-October / Giza',
		client: 'National Organization for Social',
		scope: 'MEP works, interior and exterior finishing',
		facts: ['2023', '3600 m²', 'Basement, ground floor and first floor'],
		treatment: 'lead',
	},
	{
		name: 'CREATIVA',
		image: '/assets/home/project-creativa.jpeg',
		imageAlt: 'CREATIVA project image',
		location: 'Tanta University',
		client: 'Ministry of Communications and Information Technology',
		scope: 'Concrete structure, interior and exterior finishing',
		facts: ['Ground floor and 2 floors', '10 media refs in inventory'],
	},
	{
		name: 'Alfy Insurance Building',
		image: '/assets/home/project-alfy.jpg',
		imageAlt: 'Alfy Insurance Building project image',
		location: 'Ataba / Cairo',
		client: 'National Organization for Social',
		scope: 'Concrete structure, finishing and landscape',
		facts: ['2024', '9000 m²', 'Basement and 13 floors'],
	},
	{
		name: 'Gareb Insurance Building',
		image: '/assets/home/project-gareb.jpg',
		imageAlt: 'Gareb Insurance Building project image',
		location: 'El Suez',
		client: 'National Organization for Social',
		scope: 'MEP works, interior and exterior finishing',
		facts: ['2100 m²', 'Ground floor and 3 floors'],
	},
	{
		name: 'Horse Farm Mosque',
		image: '/assets/home/project-mosque.jpg',
		imageAlt: 'Horse Farm Mosque project image',
		location: 'New capital city',
		client: 'Armed Forces Engineering Authority Military Works Department',
		scope: 'Concrete structure, finishing and landscape',
		facts: ['2021', '12 months', '8 media refs in inventory'],
	},
	{
		name: 'Hangers',
		image: '/assets/home/project-hangers.jpg',
		imageAlt: 'Hangers project image',
		location: 'Buni Suayf',
		client: 'Armed Forces Engineering Authority Military Works Department',
		scope: 'Concrete structure, finishing and landscape',
		facts: ['2022', '12 months'],
	},
] as const;

const capabilities = [
	{
		name: 'Concrete structure',
		proof: 'Repeated across CREATIVA, Alfy Insurance Building, Horse Farm Mosque and Hangers.',
	},
	{
		name: 'Interior and exterior finishing',
		proof: 'Verified in every provisional featured project selected for this V1 prototype.',
	},
	{
		name: 'MEP works',
		proof: 'Appears in the 6-October and Gareb Insurance Building project records.',
	},
	{
		name: 'Landscape',
		proof: 'Appears in Alfy Insurance Building, Horse Farm Mosque and Hangers scopes.',
	},
] as const;

const proofItems = [
	{
		value: '12',
		label: 'project detail pages inventoried',
		note: 'Current legacy mirror inventory, not a final public portfolio count.',
	},
	{
		value: '306',
		label: 'unique referenced media assets',
		note: 'Inventory result across the legacy site; final image shortlist still needs review.',
	},
	{
		value: '4',
		label: 'recurring capability groups shown here',
		note: 'Concrete structure, finishing, MEP works and landscape from real project scopes.',
	},
] as const;
---

<!doctype html>
<html lang="en" dir="ltr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="googlebot" content="noindex, nofollow" />
		<AstroAssets.Font cssVariable="--font-jost" />
		<AstroAssets.Font cssVariable="--font-poppins" />
		<title>AL MASA Homepage Redesign Prototype V1</title>
	</head>
	<body>
		<div class="redesign-page" id="top" data-redesign-page>
			<header class="prototype-shell" aria-label="Prototype navigation">
				<a class="prototype-shell__brand" href="#top" aria-label="AL MASA redesign prototype top">
					<img src="/assets/almasa-logo.png" alt="AL MASA" width="717" height="336" loading="eager" />
				</a>
				<nav class="prototype-shell__nav" aria-label="Prototype sections">
					<a href="#featured-projects">Projects</a>
					<a href="#capabilities">Capabilities</a>
					<a href="#credibility">Proof</a>
					<a href="#contact">Contact</a>
				</nav>
			</header>

			<main>
				<section class="prototype-status" aria-label="Prototype status">
					<span>Internal prototype</span>
					<span>Not final</span>
					<span>Not owner approved</span>
					<span>English V1 only</span>
				</section>

				<section class="redesign-hero" aria-labelledby="hero-title" data-hero-media data-video-ready="false">
					<div class="redesign-hero__media" aria-label="Media-flexible hero area">
						<img
							class="redesign-hero__fallback"
							src={heroMedia.poster}
							alt={heroMedia.alt}
							width="1280"
							height="572"
							loading="eager"
							fetchpriority="high"
						/>
						{heroMedia.videoSrc && (
							<video
								class="redesign-hero__video"
								muted
								playsinline
								loop
								preload="metadata"
								poster={heroMedia.poster}
								aria-label="Future optional hero video layer"
								data-hero-video
							>
								<source src={heroMedia.videoSrc} type={heroMedia.videoType} />
							</video>
						)}
						<div class="redesign-hero__scrim" aria-hidden="true"></div>
					</div>

					<div class="redesign-hero__content">
						<p class="section-kicker">Homepage redesign prototype V1</p>
						<h1 id="hero-title">Show AL MASA through the work first.</h1>
						<p>
							A project-led homepage direction that keeps AL MASA blue and white, uses real company work,
							and prepares the hero to accept final Al Alphy image or video media later.
						</p>
						<div class="redesign-hero__actions" aria-label="Hero actions">
							<a class="prototype-button prototype-button--light" href="#featured-projects">See featured work</a>
							<a class="prototype-button prototype-button--ghost" href="#prototype-notes">Read prototype notes</a>
						</div>
					</div>

					<div class="redesign-hero__caption" id="prototype-notes">
						<strong>{heroMedia.label}</strong>
						<span>Future hero support: image or muted looping video with poster fallback, reduced-motion fallback and readable overlay.</span>
					</div>
				</section>

				<section class="prototype-section featured-projects" id="featured-projects" aria-labelledby="projects-title">
					<div class="prototype-section__intro">
						<p class="section-kicker">Featured Projects</p>
						<h2 id="projects-title">A curated project proof wall, not an autoplay carousel.</h2>
						<p>
							This provisional subset uses real project inventory data and existing AL MASA images. Final 6–10 featured projects remain a later owner/client decision.
						</p>
					</div>

					<div class="project-layout" aria-label="Provisional featured project cards">
						{featuredProjects.map((project, index) => (
							<article class:list={["project-card", { 'project-card--lead': project.treatment === 'lead' }]}>
								<div class="project-card__image-wrap">
									<img
										src={project.image}
										alt={project.imageAlt}
										width="960"
										height="640"
										loading={index < 2 ? 'eager' : 'lazy'}
									/>
								</div>
								<div class="project-card__body">
									<span class="project-card__number">{String(index + 1).padStart(2, '0')}</span>
									<h3>{project.name}</h3>
									<p>{project.scope}</p>
									<dl>
										<div>
											<dt>Location</dt>
											<dd>{project.location}</dd>
										</div>
										<div>
											<dt>Client</dt>
											<dd>{project.client}</dd>
										</div>
									</dl>
									<ul class="project-card__facts" aria-label={`${project.name} facts`}>
										{project.facts.map((fact) => <li>{fact}</li>)}
									</ul>
								</div>
							</article>
						))}
					</div>
				</section>

				<section class="prototype-section capabilities" id="capabilities" aria-labelledby="capabilities-title">
					<div class="prototype-section__intro prototype-section__intro--split">
						<div>
							<p class="section-kicker">Capabilities</p>
							<h2 id="capabilities-title">You have seen what AL MASA builds. Here is what the work proves.</h2>
						</div>
						<p>
							Capability labels stay compact and tied back to project records, avoiding long generic brochure copy.
						</p>
					</div>

					<div class="capability-grid">
						{capabilities.map((capability) => (
							<article class="capability-card">
								<span aria-hidden="true"></span>
								<h3>{capability.name}</h3>
								<p>{capability.proof}</p>
							</article>
						))}
					</div>
				</section>

				<section class="prototype-section credibility" id="credibility" aria-labelledby="credibility-title">
					<div class="prototype-section__intro">
						<p class="section-kicker">Credibility</p>
						<h2 id="credibility-title">Company proof is included only where the source supports it.</h2>
						<p>
							This V1 withholds public scale statistics that still need owner verification. The proof below is inventory-backed and intentionally labelled.
						</p>
					</div>

					<div class="proof-grid">
						{proofItems.map((item) => (
							<article class="proof-card">
								<strong>{item.value}</strong>
								<h3>{item.label}</h3>
								<p>{item.note}</p>
							</article>
						))}
					</div>

					<div class="credibility-note">
						<h3>Not shown as final facts yet</h3>
						<p>
							Claims such as 250+ projects, market-leader counts, final partners, phone numbers, forms and Arabic body copy stay out of the final-facing message until confirmed.
						</p>
					</div>
				</section>

				<section class="contact-cta" id="contact" aria-labelledby="contact-title">
					<div>
						<p class="section-kicker">Contact CTA</p>
						<h2 id="contact-title">Ready to make the next AL MASA project visible?</h2>
						<p>
							The final public CTA can point to the confirmed contact channel. This prototype intentionally includes no stale phone number and no backend form.
						</p>
					</div>
					<span class="prototype-button prototype-button--light" aria-label="Final contact action pending owner confirmation">Talk to AL MASA</span>
				</section>
			</main>
		</div>

		<script is:inline>
			(() => {
				const mediaRoot = document.querySelector('[data-hero-media]');
				const video = document.querySelector('[data-hero-video]');
				if (!(mediaRoot instanceof HTMLElement) || !(video instanceof HTMLVideoElement)) return;

				const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
				const keepFallback = () => {
					mediaRoot.dataset.videoReady = 'false';
					video.pause();
					video.removeAttribute('autoplay');
				};

				if (reducedMotion.matches) {
					keepFallback();
					return;
				}

				video.muted = true;
				video.loop = true;
				video.playsInline = true;
				video.addEventListener('canplay', () => {
					mediaRoot.dataset.videoReady = 'true';
				});
				video.addEventListener('error', keepFallback);
				video.play().catch(keepFallback);
			})();
		</script>
	</body>
</html>

<style>
	:root {
		color-scheme: light;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		background: var(--color-surface);
	}

	.redesign-page {
		--prototype-blue: var(--color-brand-primary);
		--prototype-blue-deep: #082946;
		--prototype-ink: var(--color-heading);
		--prototype-muted: #607184;
		--prototype-line: rgba(0, 58, 107, 0.14);
		--prototype-soft: #f4f7fa;
		min-block-size: 100vh;
		overflow-x: clip;
		background:
			linear-gradient(180deg, rgba(0, 58, 107, 0.045), rgba(255, 255, 255, 0) 520px),
			var(--color-surface);
		color: var(--prototype-muted);
	}

	.prototype-shell,
	.prototype-status,
	.prototype-section,
	.contact-cta,
	.redesign-hero__content,
	.redesign-hero__caption {
		inline-size: min(100% - 40px, 1280px);
		margin-inline: auto;
	}

	.prototype-shell {
		display: flex;
		position: sticky;
		z-index: 20;
		inset-block-start: 0;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		min-block-size: 88px;
		border-block-end: 1px solid var(--prototype-line);
		background: rgba(255, 255, 255, 0.9);
		backdrop-filter: blur(18px);
	}

	.prototype-shell__brand {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
	}

	.prototype-shell__brand img {
		inline-size: clamp(132px, 14vw, 190px);
		block-size: auto;
	}

	.prototype-shell__nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: flex-end;
		gap: clamp(12px, 2.2vw, 28px);
	}

	.prototype-shell__nav a {
		color: var(--prototype-ink);
		font-family: var(--font-heading);
		font-size: 0.9rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.prototype-shell__nav a:hover,
	.prototype-shell__nav a:focus-visible {
		color: var(--prototype-blue);
	}

	.prototype-status {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		padding-block: 22px 14px;
	}

	.prototype-status span,
	.section-kicker,
	.project-card__number,
	.project-card__facts li {
		font-family: var(--font-heading);
		font-size: 0.74rem;
		font-weight: 800;
		letter-spacing: 0.13em;
		text-transform: uppercase;
	}

	.prototype-status span {
		border: 1px solid rgba(0, 58, 107, 0.18);
		border-radius: 999px;
		padding: 8px 12px;
		background: #ffffff;
		color: var(--prototype-blue);
	}

	.redesign-hero {
		position: relative;
		isolation: isolate;
		min-block-size: min(820px, calc(100svh - 110px));
		overflow: hidden;
		display: grid;
		align-items: end;
		margin-block-end: clamp(70px, 9vw, 120px);
		background: var(--prototype-blue-deep);
	}

	.redesign-hero__media,
	.redesign-hero__fallback,
	.redesign-hero__video,
	.redesign-hero__scrim {
		position: absolute;
		inset: 0;
	}

	.redesign-hero__fallback,
	.redesign-hero__video {
		inline-size: 100%;
		block-size: 100%;
		object-fit: cover;
	}

	.redesign-hero__fallback {
		z-index: -4;
		filter: saturate(0.94) contrast(1.04);
	}

	.redesign-hero__video {
		z-index: -3;
		opacity: 0;
		transition: opacity 420ms ease;
	}

	.redesign-hero[data-video-ready='true'] .redesign-hero__video {
		opacity: 1;
	}

	.redesign-hero__scrim {
		z-index: -2;
		background:
			linear-gradient(90deg, rgba(0, 25, 48, 0.92), rgba(0, 58, 107, 0.72) 44%, rgba(0, 58, 107, 0.28)),
			linear-gradient(180deg, rgba(2, 13, 26, 0.12), rgba(2, 13, 26, 0.72));
	}

	.redesign-hero__content {
		position: relative;
		z-index: 2;
		padding-block: clamp(96px, 15vw, 190px) clamp(98px, 11vw, 140px);
		color: #ffffff;
	}

	.section-kicker {
		margin: 0 0 16px;
		color: var(--prototype-blue);
	}

	.redesign-hero .section-kicker,
	.contact-cta .section-kicker {
		color: rgba(255, 255, 255, 0.82);
	}

	.redesign-hero h1,
	.redesign-hero p,
	.contact-cta h2,
	.contact-cta p {
		color: inherit;
	}

	.redesign-hero h1 {
		max-inline-size: 860px;
		margin: 0;
		font-size: clamp(3.2rem, 8vw, 7.35rem);
		font-weight: 800;
		letter-spacing: -0.065em;
		line-height: 0.9;
		text-transform: uppercase;
	}

	.redesign-hero__content > p:not(.section-kicker) {
		max-inline-size: 680px;
		margin: 28px 0 0;
		color: rgba(255, 255, 255, 0.84);
		font-size: clamp(1.05rem, 1.6vw, 1.35rem);
		line-height: 1.7;
	}

	.redesign-hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-block-start: 34px;
	}

	.prototype-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-block-size: 50px;
		border: 1px solid transparent;
		padding: 14px 22px;
		font-family: var(--font-heading);
		font-size: 0.86rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		line-height: 1;
		text-decoration: none;
		text-transform: uppercase;
	}

	.prototype-button--light {
		background: #ffffff;
		color: var(--prototype-blue);
	}

	.prototype-button--ghost {
		border-color: rgba(255, 255, 255, 0.5);
		background: rgba(255, 255, 255, 0.08);
		color: #ffffff;
	}

	.redesign-hero__caption {
		position: absolute;
		z-index: 3;
		inset-inline: 0;
		inset-block-end: 24px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		border: 1px solid rgba(255, 255, 255, 0.18);
		padding: 14px 18px;
		background: rgba(1, 18, 35, 0.72);
		color: rgba(255, 255, 255, 0.76);
		font-size: 0.88rem;
		backdrop-filter: blur(14px);
	}

	.redesign-hero__caption strong {
		color: #ffffff;
	}

	.prototype-section {
		padding-block: clamp(70px, 8vw, 108px);
	}

	.prototype-section__intro {
		max-inline-size: 780px;
		margin-block-end: clamp(34px, 5vw, 62px);
	}

	.prototype-section__intro--split {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(280px, 0.55fr);
		gap: clamp(28px, 5vw, 70px);
		max-inline-size: none;
		align-items: end;
	}

	.prototype-section__intro h2,
	.contact-cta h2 {
		margin: 0;
		color: var(--prototype-ink);
		font-size: clamp(2.25rem, 5vw, 5.4rem);
		font-weight: 800;
		letter-spacing: -0.06em;
		line-height: 0.98;
	}

	.prototype-section__intro p:not(.section-kicker),
	.contact-cta p,
	.credibility-note p {
		margin: 20px 0 0;
		font-size: clamp(1rem, 1.35vw, 1.16rem);
		line-height: 1.8;
	}

	.project-layout {
		display: grid;
		grid-template-columns: repeat(6, minmax(0, 1fr));
		gap: clamp(18px, 2.4vw, 30px);
	}

	.project-card {
		display: grid;
		grid-column: span 2;
		grid-template-rows: auto 1fr;
		overflow: hidden;
		border: 1px solid var(--prototype-line);
		background: #ffffff;
		box-shadow: 0 24px 70px rgba(8, 41, 70, 0.08);
	}

	.project-card--lead {
		grid-column: span 4;
		grid-row: span 2;
		grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
		grid-template-rows: 1fr;
		min-block-size: 650px;
	}

	.project-card__image-wrap {
		overflow: hidden;
		background: var(--prototype-blue-deep);
	}

	.project-card img {
		inline-size: 100%;
		block-size: 100%;
		min-block-size: 300px;
		object-fit: cover;
		transition: transform 520ms ease, opacity 520ms ease;
	}

	.project-card:not(.project-card--lead) img {
		aspect-ratio: 1.22;
	}

	.project-card:hover img,
	.project-card:focus-within img {
		opacity: 0.92;
		transform: scale(1.035);
	}

	.project-card__body {
		display: grid;
		align-content: start;
		gap: 16px;
		padding: clamp(24px, 3vw, 38px);
	}

	.project-card__number {
		color: var(--prototype-blue);
	}

	.project-card h3,
	.capability-card h3,
	.proof-card h3,
	.credibility-note h3 {
		margin: 0;
		color: var(--prototype-ink);
		font-size: clamp(1.32rem, 2vw, 2rem);
		line-height: 1.12;
	}

	.project-card p,
	.capability-card p,
	.proof-card p {
		margin: 0;
		line-height: 1.75;
	}

	.project-card dl {
		display: grid;
		gap: 12px;
		margin: 4px 0 0;
	}

	.project-card dl div {
		display: grid;
		gap: 3px;
	}

	.project-card dt {
		color: var(--prototype-blue);
		font-family: var(--font-heading);
		font-size: 0.74rem;
		font-weight: 800;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	.project-card dd {
		margin: 0;
		color: var(--prototype-ink);
		font-weight: 600;
		line-height: 1.5;
	}

	.project-card__facts {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 4px 0 0;
		padding: 0;
		list-style: none;
	}

	.project-card__facts li {
		border: 1px solid rgba(0, 58, 107, 0.15);
		border-radius: 999px;
		padding: 7px 10px;
		background: var(--prototype-soft);
		color: var(--prototype-blue);
	}

	.capabilities {
		background: linear-gradient(180deg, rgba(0, 58, 107, 0.035), rgba(0, 58, 107, 0));
	}

	.capability-grid,
	.proof-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 18px;
	}

	.capability-card,
	.proof-card,
	.credibility-note {
		border: 1px solid var(--prototype-line);
		background: #ffffff;
		box-shadow: 0 18px 60px rgba(8, 41, 70, 0.06);
	}

	.capability-card {
