---
import { Font } from 'astro:assets';
import '../../../styles/global.css';

const sections = [
	{
		key: 'hero',
		title: 'الواجهة الرئيسية',
		description: 'تم تحسين أول جزء في الصفحة ليكون أوضح وأقوى على الموبايل والكمبيوتر.',
	},
	{
		key: 'services',
		title: 'الخدمات',
		description: 'تم ضبط ترتيب الخدمات والمسافات مع الحفاظ على نفس هوية الموقع.',
	},
	{
		key: 'statistics',
		title: 'الأرقام',
		description: 'تم تحسين طريقة عرض الأرقام لتظهر بشكل أوضح وأقرب لشكل الموقع الأصلي.',
	},
	{
		key: 'projects',
		title: 'أحدث المشروعات',
		description: 'تم تحسين طريقة عرض المشروعات لتكون أسهل في المشاهدة والتنقل.',
	},
	{
		key: 'about',
		title: 'من نحن',
		description: 'تم تحسين ترتيب النصوص والأزرار والعناصر المهمة داخل القسم.',
	},
	{
		key: 'news',
		title: 'الأخبار',
		description: 'تم ضبط حجم البطاقات والمسافات حتى يكون القسم أوضح وأسهل للقراءة.',
	},
	{
		key: 'partners',
		title: 'الشركاء',
		description: 'تم تحسين عرض شعارات الشركاء بشكل أبسط وأنظف.',
	},
	{
		key: 'footer',
		title: 'التواصل',
		description: 'تم تحسين نهاية الصفحة ونموذج التواصل ليكون الشكل أوضح وأكثر ترتيباً.',
	},
];

const image = (view: 'desktop' | 'mobile', key: string, side: 'before' | 'after') =>
	`/assets/review/homepage/${view}-${key}-${side}.png`;
---

<!doctype html>
<html lang="ar" dir="rtl">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="googlebot" content="noindex, nofollow" />
		<Font cssVariable="--font-jost" />
		<Font cssVariable="--font-poppins" />
		<title>مقارنة الصفحة الرئيسية | AL MASA</title>
		<script is:inline>
			(() => {
				const saved = window.localStorage.getItem('almasa-comparison-view');
				const view = saved || (window.matchMedia('(max-width: 760px)').matches ? 'mobile' : 'desktop');
				document.documentElement.dataset.reviewView = view;
			})();
		</script>
	</head>
	<body>
		<main class="review-page" aria-labelledby="page-title">
			<header class="review-hero">
				<p class="review-kicker">AL MASA</p>
				<h1 id="page-title">مقارنة الصفحة الرئيسية</h1>
				<p class="review-intro">
					مقارنة بين الصفحة الرئيسية الحالية والنسخة الجديدة. تم الحفاظ على هوية الموقع مع إعادة تنفيذ الصفحة وتحسين طريقة عرضها على الموبايل والكمبيوتر.
				</p>
				<div class="review-actions" aria-label="اختيار طريقة العرض">
					<button class="view-toggle" type="button" data-view-button="mobile" aria-pressed="false">عرض الموبايل</button>
					<button class="view-toggle" type="button" data-view-button="desktop" aria-pressed="true">عرض الكمبيوتر</button>
				</div>
			</header>

			<section class="view-set view-set--desktop" data-view-set="desktop" aria-label="مقارنة الكمبيوتر">
				{sections.map((section, index) => (
					<article class="comparison-section" id={`desktop-${section.key}`}>
						<div class="section-copy">
							<span class="section-number">{String(index + 1).padStart(2, '0')}</span>
							<div>
								<h2>{section.title}</h2>
								<p>{section.description}</p>
							</div>
						</div>
						<div class="comparison-grid comparison-grid--desktop">
							<figure class="screenshot-card">
								<figcaption>قبل</figcaption>
								<img src={image('desktop', section.key, 'before')} alt={`قبل - ${section.title} على الكمبيوتر`} width="1440" height="900" loading={index < 2 ? 'eager' : 'lazy'} decoding="async" />
							</figure>
							<figure class="screenshot-card screenshot-card--after">
								<figcaption>بعد</figcaption>
								<img src={image('desktop', section.key, 'after')} alt={`بعد - ${section.title} على الكمبيوتر`} width="1440" height="900" loading={index < 2 ? 'eager' : 'lazy'} decoding="async" />
							</figure>
						</div>
					</article>
				))}
			</section>

			<section class="view-set view-set--mobile" data-view-set="mobile" aria-label="مقارنة الموبايل">
				{sections.map((section, index) => (
					<article class="comparison-section" id={`mobile-${section.key}`}>
						<div class="section-copy">
							<span class="section-number">{String(index + 1).padStart(2, '0')}</span>
							<div>
								<h2>{section.title}</h2>
								<p>{section.description}</p>
							</div>
						</div>
						<div class="comparison-grid comparison-grid--mobile">
							<figure class="screenshot-card screenshot-card--phone">
								<figcaption>قبل</figcaption>
								<img src={image('mobile', section.key, 'before')} alt={`قبل - ${section.title} على الموبايل`} width="390" height="844" loading={index < 2 ? 'eager' : 'lazy'} decoding="async" />
							</figure>
							<figure class="screenshot-card screenshot-card--phone screenshot-card--after">
								<figcaption>بعد</figcaption>
								<img src={image('mobile', section.key, 'after')} alt={`بعد - ${section.title} على الموبايل`} width="390" height="844" loading={index < 2 ? 'eager' : 'lazy'} decoding="async" />
							</figure>
						</div>
					</article>
				))}
			</section>

			<footer class="review-footer">
				<a class="homepage-link" href="/en/" target="_blank" rel="noopener">مشاهدة الصفحة الجديدة</a>
			</footer>
		</main>

		<script is:inline>
			(() => {
				const buttons = Array.from(document.querySelectorAll('[data-view-button]'));
				const setView = (view) => {
					document.documentElement.dataset.reviewView = view;
					window.localStorage.setItem('almasa-comparison-view', view);
					buttons.forEach((button) => {
						button.setAttribute('aria-pressed', String(button.dataset.viewButton === view));
					});
				};

				buttons.forEach((button) => {
					button.addEventListener('click', () => setView(button.dataset.viewButton));
				});

				setView(document.documentElement.dataset.reviewView || 'desktop');
			})();
		</script>
	</body>
</html>

<style>
	:root {
		color-scheme: light;
	}

	body {
		margin: 0;
		background: #f3f1f2;
		color: var(--color-heading);
		font-family: var(--font-poppins), var(--font-jost), system-ui, sans-serif;
	}

	.review-page {
		min-block-size: 100vh;
		padding: clamp(20px, 4vw, 56px);
	}

	.review-hero,
	.comparison-section,
	.review-footer {
		inline-size: min(100%, 1780px);
		margin-inline: auto;
	}

	.review-hero {
		display: grid;
		gap: 18px;
		padding: clamp(24px, 4vw, 56px);
		border: 1px solid rgba(0, 58, 107, 0.12);
		border-radius: 28px;
		background: #ffffff;
		box-shadow: 0 22px 70px rgba(22, 50, 87, 0.08);
	}

	.review-kicker {
		margin: 0;
		color: var(--color-brand-primary);
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	h1,
	h2,
	p,
	figure {
		margin: 0;
	}

	h1 {
		font-size: clamp(2rem, 5vw, 4.9rem);
		line-height: 1.05;
		font-weight: 800;
	}

	.review-intro {
		max-inline-size: 760px;
		color: var(--color-text);
		font-size: clamp(1rem, 1.4vw, 1.25rem);
		line-height: 1.9;
	}

	.review-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-block-start: 8px;
	}

	.view-toggle,
	.homepage-link {
		border: 0;
		border-radius: 999px;
		font: inherit;
		font-weight: 700;
		text-decoration: none;
		cursor: pointer;
	}

	.view-toggle {
		padding: 12px 22px;
		background: #e8edf2;
		color: var(--color-heading);
	}

	.view-toggle[aria-pressed='true'],
	.homepage-link {
		background: var(--color-brand-primary);
		color: #ffffff;
	}

	.view-set {
		display: grid;
		gap: clamp(28px, 5vw, 64px);
		margin-block-start: clamp(28px, 5vw, 64px);
	}

	html[data-review-view='desktop'] .view-set--mobile,
	html[data-review-view='mobile'] .view-set--desktop {
		display: none;
	}

	@media (max-width: 760px) {
		html:not([data-review-view]) .view-set--desktop {
			display: none;
		}
	}

	@media (min-width: 761px) {
		html:not([data-review-view]) .view-set--mobile {
			display: none;
		}
	}

	.comparison-section {
		display: grid;
		gap: clamp(16px, 2.6vw, 28px);
	}

	.section-copy {
		display: flex;
		align-items: start;
		gap: 16px;
	}

	.section-number {
		display: inline-grid;
		place-items: center;
		min-inline-size: 54px;
		block-size: 54px;
		border-radius: 18px;
		background: var(--color-brand-primary);
		color: #ffffff;
		font-weight: 800;
	}

	.section-copy h2 {
		font-size: clamp(1.6rem, 3vw, 2.7rem);
		line-height: 1.15;
	}

	.section-copy p {
		max-inline-size: 780px;
		margin-block-start: 8px;
		color: var(--color-text);
		font-size: clamp(0.98rem, 1.2vw, 1.16rem);
		line-height: 1.8;
	}

	.comparison-grid {
		display: grid;
		gap: clamp(16px, 2vw, 28px);
		align-items: start;
	}

	.comparison-grid--desktop {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.comparison-grid--mobile {
		grid-template-columns: repeat(2, minmax(260px, 390px));
		justify-content: center;
	}

	.screenshot-card {
		overflow: hidden;
		border: 1px solid rgba(22, 50, 87, 0.16);
		border-radius: 22px;
		background: #ffffff;
		box-shadow: 0 20px 60px rgba(22, 50, 87, 0.1);
	}

	.screenshot-card figcaption {
		display: flex;
		align-items: center;
		justify-content: center;
		min-block-size: 52px;
		background: #1d2f48;
		color: #ffffff;
		font-size: clamp(1rem, 1.3vw, 1.2rem);
		font-weight: 800;
	}

	.screenshot-card--after figcaption {
		background: var(--color-brand-primary);
	}

	.screenshot-card img {
		display: block;
		inline-size: 100%;
		block-size: auto;
	}

	.screenshot-card--phone {
		max-inline-size: 430px;
		justify-self: center;
	}

	.review-footer {
		display: flex;
		justify-content: center;
		padding-block: clamp(34px, 6vw, 80px) clamp(10px, 2vw, 20px);
	}

	.homepage-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-block-size: 56px;
		padding-inline: 30px;
		box-shadow: 0 18px 40px rgba(0, 58, 107, 0.24);
	}

	@media (max-width: 900px) {
		.review-page {
			padding: 16px;
		}

		.review-hero {
			border-radius: 22px;
		}

		.comparison-grid--desktop,
		.comparison-grid--mobile {
			grid-template-columns: 1fr;
		}

		.screenshot-card--phone {
			inline-size: min(100%, 430px);
		}
	}

	@media (min-width: 1700px) {
		.review-page {
			padding-inline: 72px;
		}

		.comparison-grid--mobile {
			grid-template-columns: repeat(2, 430px);
		}
	}
</style>
