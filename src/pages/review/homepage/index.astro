---
import { Font } from 'astro:assets';
import '../../../styles/global.css';

const languages = [
	{
		key: 'en',
		label: 'مقارنة النسخة الإنجليزية',
		ariaLabel: 'مقارنة النسخة الإنجليزية من الموقع',
		buttonHref: '/en/',
	},
	{
		key: 'ar',
		label: 'مقارنة النسخة العربية',
		ariaLabel: 'مقارنة النسخة العربية من الموقع',
		buttonHref: '/ar/',
	},
] as const;

const views = [
	{ key: 'desktop', label: 'عرض الكمبيوتر', ariaLabel: 'عرض مقارنة الكمبيوتر' },
	{ key: 'mobile', label: 'عرض الموبايل', ariaLabel: 'عرض مقارنة الموبايل' },
] as const;

const sections = [
	{
		key: 'hero',
		title: 'الواجهة الرئيسية',
		description: 'مقارنة أول ظهور في الصفحة، مع التأكد من أن صورة الخلفية والنص ظاهرين بشكل صحيح.',
	},
	{
		key: 'services',
		title: 'الخدمات',
		description: 'مقارنة قسم الخدمات بعد ظهور البطاقات والصور والنصوص بالكامل.',
	},
	{
		key: 'statistics',
		title: 'الأرقام',
		description: 'مقارنة قسم الأرقام بعد ظهور القيم الصحيحة وليس أثناء بداية العد.',
	},
	{
		key: 'projects',
		title: 'أحدث المشروعات',
		description: 'مقارنة عرض المشروعات في حالة ثابتة وواضحة بدون انتقال أو قص غير مقصود.',
	},
	{
		key: 'about',
		title: 'من نحن',
		description: 'مقارنة قسم التعريف بالشركة والصورة/الشعار المستخدم داخل القسم.',
	},
	{
		key: 'news',
		title: 'الأخبار',
		description: 'مقارنة قسم الأخبار مع التأكد من أن البطاقات المعروضة تخص هذا القسم فقط.',
	},
	{
		key: 'partners',
		title: 'الشركاء',
		description: 'مقارنة شعارات الشركاء في حالة مستقرة وواضحة.',
	},
	{
		key: 'footer',
		title: 'التواصل',
		description: 'مقارنة نهاية الصفحة ومنطقة التواصل بعد إزالة أرقام الهاتف غير المطلوبة في النسخة الجديدة.',
	},
] as const;

const image = (locale: string, view: string, key: string, side: 'before' | 'after') =>
	`/assets/review/homepage/${locale}-${view}-${key}-${side}.png`;
---

<!doctype html>
<html lang="ar" dir="rtl" data-review-locale="en" data-review-view="desktop">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="googlebot" content="noindex, nofollow" />
		<Font cssVariable="--font-jost" />
		<Font cssVariable="--font-poppins" />
		<title>مقارنة الصفحة الرئيسية | AL MASA</title>
		<script is:inline>
			(() => {
				const savedLocale = window.localStorage.getItem('almasa-comparison-locale');
				const savedView = window.localStorage.getItem('almasa-comparison-view');
				const view = savedView || (window.matchMedia('(max-width: 760px)').matches ? 'mobile' : 'desktop');
				document.documentElement.dataset.reviewLocale = savedLocale || 'en';
				document.documentElement.dataset.reviewView = view;
			})();
		</script>
	</head>
	<body>
		<main class="review-page" aria-labelledby="page-title">
			<header class="review-hero">
				<p class="review-kicker">AL MASA</p>
				<h1 id="page-title">مقارنة الصفحة الرئيسية</h1>
				<p class="review-intro">
					مقارنة بين الصفحة الحالية والنسخة الجديدة. اختر النسخة الإنجليزية أو العربية، ثم اختر عرض الكمبيوتر أو الموبايل.
				</p>
				<div class="review-control-group" aria-label="اختيار لغة المقارنة">
					{languages.map((language) => (
						<button class="review-toggle" type="button" data-locale-button={language.key} aria-label={language.ariaLabel} aria-pressed={language.key === 'en' ? 'true' : 'false'}>
							{language.label}
						</button>
					))}
				</div>
				<div class="review-control-group" aria-label="اختيار طريقة العرض">
					{views.map((view) => (
						<button class="review-toggle" type="button" data-view-button={view.key} aria-label={view.ariaLabel} aria-pressed={view.key === 'desktop' ? 'true' : 'false'}>
							{view.label}
						</button>
					))}
				</div>
			</header>

			{languages.map((language) => (
				<div class="language-set" data-language-set={language.key} aria-label={language.ariaLabel}>
					{views.map((view) => (
						<section class:list={["view-set", `view-set--${view.key}`]} data-view-set={view.key} aria-label={view.ariaLabel}>
							{sections.map((section, index) => (
								<article class="comparison-section" id={`${language.key}-${view.key}-${section.key}`}>
									<div class="section-copy">
										<span class="section-number">{String(index + 1).padStart(2, '0')}</span>
										<div>
											<h2>{section.title}</h2>
											<p>{section.description}</p>
										</div>
									</div>
									<div class:list={["comparison-grid", `comparison-grid--${view.key}`]}>
										<figure class:list={["screenshot-card", { 'screenshot-card--phone': view.key === 'mobile' }]}>
											<figcaption>قبل</figcaption>
											<img
												src={image(language.key, view.key, section.key, 'before')}
												alt={`قبل - ${section.title} - ${language.label} - ${view.label}`}
												width={view.key === 'desktop' ? '1440' : '390'}
												height={view.key === 'desktop' ? '900' : '844'}
												loading={index < 2 ? 'eager' : 'lazy'}
												decoding="async"
											/>
										</figure>
										<figure class:list={["screenshot-card", "screenshot-card--after", { 'screenshot-card--phone': view.key === 'mobile' }]}>
											<figcaption>بعد</figcaption>
											<img
												src={image(language.key, view.key, section.key, 'after')}
												alt={`بعد - ${section.title} - ${language.label} - ${view.label}`}
												width={view.key === 'desktop' ? '1440' : '390'}
												height={view.key === 'desktop' ? '900' : '844'}
												loading={index < 2 ? 'eager' : 'lazy'}
												decoding="async"
											/>
										</figure>
									</div>
								</article>
							))}
						</section>
					))}
				</div>
			))}

			<footer class="review-footer">
				{languages.map((language) => (
					<a class="homepage-link" data-homepage-link={language.key} href={language.buttonHref} target="_blank" rel="noopener">مشاهدة الصفحة الجديدة</a>
				))}
			</footer>
		</main>

		<script is:inline>
			(() => {
				const localeButtons = Array.from(document.querySelectorAll('[data-locale-button]'));
				const viewButtons = Array.from(document.querySelectorAll('[data-view-button]'));

				const setLocale = (locale) => {
					document.documentElement.dataset.reviewLocale = locale;
					window.localStorage.setItem('almasa-comparison-locale', locale);
					localeButtons.forEach((button) => {
						button.setAttribute('aria-pressed', String(button.dataset.localeButton === locale));
					});
				};

				const setView = (view) => {
					document.documentElement.dataset.reviewView = view;
					window.localStorage.setItem('almasa-comparison-view', view);
					viewButtons.forEach((button) => {
						button.setAttribute('aria-pressed', String(button.dataset.viewButton === view));
					});
				};

				localeButtons.forEach((button) => {
					button.addEventListener('click', () => setLocale(button.dataset.localeButton));
				});

				viewButtons.forEach((button) => {
					button.addEventListener('click', () => setView(button.dataset.viewButton));
				});

				setLocale(document.documentElement.dataset.reviewLocale || 'en');
				setView(document.documentElement.dataset.reviewView || 'desktop');
			})();
		</script>
	</body>
</html>

<style>
	:root {
		color-scheme: light;
	}

	body {
		margin: 0;
		background: #f3f1f2;
		color: var(--color-heading);
		font-family: var(--font-poppins), var(--font-jost), system-ui, sans-serif;
	}

	.review-page {
		min-block-size: 100vh;
		padding: clamp(20px, 4vw, 56px);
	}

	.review-hero,
	.comparison-section,
	.review-footer {
		inline-size: min(100%, 1780px);
		margin-inline: auto;
	}

	.review-hero {
		display: grid;
		gap: 18px;
		padding: clamp(24px, 4vw, 56px);
		border: 1px solid rgba(0, 58, 107, 0.12);
		border-radius: 28px;
		background: #ffffff;
		box-shadow: 0 22px 70px rgba(22, 50, 87, 0.08);
	}

	.review-kicker {
		margin: 0;
		color: var(--color-brand-primary);
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	h1,
	h2,
	p,
	figure {
		margin: 0;
	}

	h1 {
		font-size: clamp(2rem, 5vw, 4.9rem);
		line-height: 1.05;
		font-weight: 800;
	}

	.review-intro {
		max-inline-size: 760px;
		color: var(--color-text);
		font-size: clamp(1rem, 1.4vw, 1.25rem);
		line-height: 1.9;
	}

	.review-control-group {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-block-start: 4px;
	}

	.review-toggle,
	.homepage-link {
		border: 0;
		border-radius: 999px;
		font: inherit;
		font-weight: 700;
		text-decoration: none;
		cursor: pointer;
	}

	.review-toggle {
		padding: 12px 22px;
		background: #e8edf2;
		color: var(--color-heading);
	}

	.review-toggle[aria-pressed='true'],
	.homepage-link {
		background: var(--color-brand-primary);
		color: #ffffff;
	}

	.language-set,
	.view-set {
		display: grid;
		gap: clamp(28px, 5vw, 64px);
		margin-block-start: clamp(28px, 5vw, 64px);
	}

	.language-set .view-set {
		margin-block-start: 0;
	}

	html[data-review-locale='en'] [data-language-set='ar'],
	html[data-review-locale='ar'] [data-language-set='en'],
	html[data-review-view='desktop'] [data-view-set='mobile'],
	html[data-review-view='mobile'] [data-view-set='desktop'],
	html[data-review-locale='en'] [data-homepage-link='ar'],
	html[data-review-locale='ar'] [data-homepage-link='en'] {
		display: none;
	}

	.comparison-section {
		display: grid;
		gap: clamp(16px, 2.6vw, 28px);
	}

	.section-copy {
		display: flex;
		align-items: start;
		gap: 16px;
	}

	.section-number {
		display: inline-grid;
		place-items: center;
		min-inline-size: 54px;
		block-size: 54px;
		border-radius: 18px;
		background: var(--color-brand-primary);
		color: #ffffff;
		font-weight: 800;
	}

	.section-copy h2 {
		font-size: clamp(1.6rem, 3vw, 2.7rem);
		line-height: 1.15;
	}

	.section-copy p {
		max-inline-size: 780px;
		margin-block-start: 8px;
		color: var(--color-text);
		font-size: clamp(0.98rem, 1.2vw, 1.16rem);
		line-height: 1.8;
	}

	.comparison-grid {
		display: grid;
		gap: clamp(16px, 2vw, 28px);
		align-items: start;
	}

	.comparison-grid--desktop {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.comparison-grid--mobile {
		grid-template-columns: 1fr;
		justify-items: center;
	}

	.screenshot-card {
		overflow: hidden;
		border: 1px solid rgba(22, 50, 87, 0.16);
		border-radius: 22px;
		background: #ffffff;
		box-shadow: 0 20px 60px rgba(22, 50, 87, 0.1);
	}

	.screenshot-card figcaption {
		display: flex;
		align-items: center;
		justify-content: center;
		min-block-size: 52px;
		background: #1d2f48;
		color: #ffffff;
		font-size: clamp(1rem, 1.3vw, 1.2rem);
		font-weight: 800;
	}

	.screenshot-card--after figcaption {
		background: var(--color-brand-primary);
	}

	.screenshot-card img {
		display: block;
		inline-size: 100%;
		block-size: auto;
	}

	.screenshot-card--phone {
		inline-size: min(100%, 430px);
	}

	.review-footer {
		display: flex;
		justify-content: center;
		padding-block: clamp(34px, 6vw, 80px) clamp(10px, 2vw, 20px);
	}

	.homepage-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-block-size: 56px;
		padding-inline: 30px;
		box-shadow: 0 18px 40px rgba(0, 58, 107, 0.24);
	}

	@media (max-width: 900px) {
		.review-page {
			padding: 16px;
		}

		.review-hero {
			border-radius: 22px;
		}

		.comparison-grid--desktop {
			grid-template-columns: 1fr;
		}
	}

	@media (min-width: 1700px) {
		.review-page {
			padding-inline: 72px;
		}
	}
</style>
