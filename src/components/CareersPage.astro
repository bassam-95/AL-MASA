---
import * as careersData from '../data/careers';

const locale = Astro.props.locale;
const t = careersData.careersLabels[locale];
const vacancies = careersData.vacancies;
const fields = careersData.fieldSets.default;

const groups = [
	{ id: 'about', title: t.sectionAbout },
	{ id: 'experience', title: t.sectionExperience },
	{ id: 'cv', title: t.sectionCv },
	{ id: 'message', title: t.sectionMessage },
];
---

<div class="owner-careers" data-owner-careers data-locale={locale}>
	<header class="oc-nav" aria-label={locale === 'ar' ? 'التنقل' : 'Navigation'}>
		<div class="owner-container oc-nav__inner">
			<a class="oc-brand" href={t.homeHref} aria-label={t.brand}>
				<img src="/assets/owner-confirmed/brand/logo-primary.png" alt={t.brand} width="85" height="40" />
				<span>{t.brand}</span>
			</a>
			<nav class="oc-nav__links" aria-label={locale === 'ar' ? 'روابط' : 'Links'}>
				<a href={t.homeHref}>{t.back}</a>
				<a class="oc-nav__lang" href={t.switchHref} lang={locale === 'ar' ? 'en' : 'ar'}>{t.switchLabel}</a>
			</nav>
		</div>
	</header>

	<section class="oc-hero">
		<div class="owner-container oc-hero__inner">
			<div class="oc-hero__text">
				<p class="oc-kicker">{t.kicker}</p>
				<h1>{t.title}</h1>
				<p class="oc-hero__intro">{t.intro}</p>
				<a class="oc-button" href="#apply">{t.heroAction} <span aria-hidden="true" class="oc-arrow">&rarr;</span></a>
			</div>
			<div class="oc-hero__visual">
				<div class="oc-hero__frame">
					<img
						src="/assets/owner-confirmed/mega/completed/project-37-khairat-rahman.jpg"
						alt={t.heroImageAlt}
						width="1200"
						height="800"
						loading="eager"
						decoding="async"
					/>
				</div>
			</div>
		</div>
	</section>

	<section class="oc-roles" aria-labelledby="oc-roles-title">
		<div class="owner-container">
			<h2 class="oc-heading" id="oc-roles-title">{t.rolesTitle}</h2>
			<ul class="oc-roles__list">
				{
					vacancies.map((vacancy) => (
						<li class="oc-role">
							<div class="oc-role__text">
								<div class="oc-role__chips">
									<span class="oc-role__tag">{vacancy.tag[locale]}</span>
									{vacancy.meta && vacancy.meta[locale].map((chip) => <span class="oc-role__chip">{chip}</span>)}
								</div>
								<h3>{vacancy.title[locale]}</h3>
								<p>{vacancy.summary[locale]}</p>
							</div>
							<a class="oc-role__apply" href="#apply" data-oc-pick={vacancy.id}>
								{t.apply} <span aria-hidden="true" class="oc-arrow">&rarr;</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="oc-apply" id="apply" aria-labelledby="oc-apply-title">
		<div class="owner-container oc-apply__inner">
			<aside class="oc-apply__aside">
				<h2 class="oc-heading" id="oc-apply-title">{t.formTitle}</h2>
				<ol class="oc-progress" aria-hidden="true">
					{
						t.progress.map((item, index) => (
							<li class:list={['oc-progress__item', { 'is-active': index === 0 }]} data-oc-progress={groups[index].id}>
								<span>{String(index + 1).padStart(2, '0')}</span>
								{item}
							</li>
						))
					}
				</ol>
			</aside>

			<form class="oc-form" novalidate data-oc-form>
				<p class="oc-notice" role="note">{t.notice}</p>

				<div class="oc-field oc-field--full">
					<label for="oc-vacancy">{t.vacancyLabel}</label>
					<select id="oc-vacancy" name="vacancy" required>
						{vacancies.map((vacancy) => <option value={vacancy.id}>{vacancy.title[locale]}</option>)}
					</select>
				</div>

				{
					groups.map((group) => (
						<fieldset class="oc-group" data-oc-group={group.id}>
							<legend>{group.title}</legend>
							<div class="oc-group__grid">
								{fields
									.filter((field) => field.group === group.id)
									.map((field) => {
										const id = 'oc-' + field.id;
										const label = field.label[locale];
										const wide = field.type === 'textarea' || field.type === 'file';
										return (
											<div class:list={['oc-field', { 'oc-field--full': wide }]}>
												{field.type === 'file' ? (
													<>
														<span class="oc-label" id={id + '-label'}>
															{label}
															{field.required && <i aria-hidden="true">*</i>}
														</span>
														<label class="oc-drop" for={id} data-oc-drop>
															<input id={id} name={field.id} type="file" accept=".pdf,.doc,.docx" required={field.required} aria-labelledby={id + '-label'} />
															<svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true" focusable="false">
																<path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5M5 16v2.5A1.5 1.5 0 0 0 6.5 20h11a1.5 1.5 0 0 0 1.5-1.5V16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
															</svg>
															<strong data-oc-file-name>{t.uploadTitle}</strong>
															<small>{t.uploadHint}</small>
														</label>
													</>
												) : (
													<>
														<label for={id}>
															{label}
															{field.required && <i aria-hidden="true">*</i>}
														</label>
														{field.type === 'textarea' ? (
															<textarea id={id} name={field.id} rows="5"></textarea>
														) : field.type === 'select' ? (
															<select id={id} name={field.id} required={field.required}>
																<option value="">{t.select}</option>
																{field.options.map((option) => <option value={option.en}>{option[locale]}</option>)}
															</select>
														) : (
															<input id={id} name={field.id} type={field.type} required={field.required} autocomplete={field.autocomplete} />
														)}
													</>
												)}
											</div>
										);
									})}
							</div>
						</fieldset>
					))
				}

				<label class="oc-consent">
					<input type="checkbox" name="consent" required />
					<span>
						{t.consent}
						<small>{t.consentNote}</small>
					</span>
				</label>

				<div class="oc-actions">
					<button class="oc-button oc-button--submit" type="submit">{t.submit} <span aria-hidden="true" class="oc-arrow">&rarr;</span></button>
					<p class="oc-preview-message" role="status" aria-live="polite" data-oc-message hidden>{t.previewMessage}</p>
				</div>
			</form>
		</div>
	</section>
</div>

<script>
	const root = document.querySelector('[data-owner-careers]');

	if (root instanceof HTMLElement) {
		const form = root.querySelector('[data-oc-form]');
		const message = root.querySelector('[data-oc-message]');

		if (form instanceof HTMLFormElement) {
			// Choosing a role card preselects it in the form.
			root.querySelectorAll('[data-oc-pick]').forEach((link) => {
				link.addEventListener('click', () => {
					const select = form.querySelector('#oc-vacancy');
					const id = link.getAttribute('data-oc-pick');
					if (select instanceof HTMLSelectElement && id) select.value = id;
				});
			});

			// Show the chosen CV file name.
			const fileInput = form.querySelector('input[type="file"]');
			const fileName = form.querySelector('[data-oc-file-name]');
			const drop = form.querySelector('[data-oc-drop]');
			if (fileInput instanceof HTMLInputElement && fileName instanceof HTMLElement) {
				const original = fileName.textContent;
				fileInput.addEventListener('change', () => {
					const chosen = fileInput.files && fileInput.files[0];
					fileName.textContent = chosen ? chosen.name : original;
					if (drop instanceof HTMLElement) drop.classList.toggle('has-file', Boolean(chosen));
				});
			}
			if (drop instanceof HTMLElement) {
				['dragenter', 'dragover'].forEach((type) => drop.addEventListener(type, () => drop.classList.add('is-dragging')));
				['dragleave', 'drop'].forEach((type) => drop.addEventListener(type, () => drop.classList.remove('is-dragging')));
			}

			// Preview only: validate, then show that nothing was sent.
			form.addEventListener('submit', (event) => {
				event.preventDefault();
				if (message instanceof HTMLElement) message.hidden = true;
				if (!form.checkValidity()) {
					form.reportValidity();
					return;
				}
				if (message instanceof HTMLElement) message.hidden = false;
			});
		}

		// Highlight the current step in the side list while scrolling.
		const items = Array.from(root.querySelectorAll('[data-oc-progress]'));
		const groups = Array.from(root.querySelectorAll('[data-oc-group]'));
		if ('IntersectionObserver' in window && items.length && groups.length) {
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;
						const id = entry.target.getAttribute('data-oc-group');
						items.forEach((item) => item.classList.toggle('is-active', item.getAttribute('data-oc-progress') === id));
					});
				},
				{ rootMargin: '-35% 0px -55% 0px' },
			);
			groups.forEach((group) => observer.observe(group));
		}
	}
</script>

<style>
	.owner-careers {
		--bg-main: #ffffff;
		--surface-soft: #e8f6fe;
		--surface-soft-border: rgba(8, 145, 178, 0.16);
		--serene-accent: #0891b2;
		--serene-accent-hover: #0e7490;
		--almasa-blue: #003a6b;
		--almasa-blue-hover: #002b50;
		--text-primary: #0f172a;
		--text-secondary: #475569;
		--text-muted: #64748b;
		--border-subtle: #e2e8f0;
		--font-display: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
		--font-ui: 'Inter', 'Segoe UI', Arial, sans-serif;
		min-block-size: 100vh;
		background: var(--bg-main);
		color: var(--text-primary);
		font-family: var(--font-ui);
		padding: 0 0 var(--layout-section-space);
		overflow-x: clip;
	}

	.owner-careers *,
	.owner-careers *::before,
	.owner-careers *::after {
		box-sizing: border-box;
	}

	/* ---- header (same look as the homepage nav) ---- */
	.oc-nav {
		position: sticky;
		inset-block-start: 0;
		z-index: 100;
		block-size: 54px;
		display: flex;
		align-items: center;
		background: rgba(255, 255, 255, 0.96);
		border-block-end: 1px solid rgba(8, 145, 178, 0.12);
		backdrop-filter: blur(14px);
	}

	.oc-nav__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
	}

	.oc-brand {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		color: var(--almasa-blue);
		text-decoration: none;
	}

	.oc-brand img {
		inline-size: auto;
		block-size: 26px;
		object-fit: contain;
	}

	.oc-brand span {
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 700;
		letter-spacing: 1.5px;
		text-transform: uppercase;
	}

	.oc-nav__links {
		display: flex;
		align-items: center;
		gap: 22px;
	}

	.oc-nav__links a {
		font-size: 0.82rem;
		font-weight: 500;
		color: var(--text-secondary);
		text-decoration: none;
		white-space: nowrap;
		transition: color 0.2s ease;
	}

	.oc-nav__links a:hover {
		color: var(--serene-accent);
	}

	.oc-nav__links .oc-nav__lang {
		padding: 5px 12px;
		border: 1px solid var(--surface-soft-border);
		border-radius: 999px;
		color: var(--almasa-blue);
		background: var(--surface-soft);
	}

	/* ---- shared bits ---- */
	.oc-kicker {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		margin: 0 0 18px;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 1.6px;
		text-transform: uppercase;
		color: var(--serene-accent);
	}

	.oc-kicker::before {
		content: '';
		inline-size: 34px;
		block-size: 2px;
		background: var(--serene-accent);
	}

	.oc-heading {
		margin: 0 0 22px;
		padding-block-end: 8px;
		border-block-end: 1px solid var(--border-subtle);
		font-family: var(--font-display);
		font-size: 1.45rem;
		font-weight: 600;
		line-height: 1.2;
		letter-spacing: 0.2px;
		color: var(--almasa-blue);
	}

	.oc-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
		min-block-size: 48px;
		padding: 0 26px;
		border: 0;
		border-radius: 10px;
		background: var(--almasa-blue);
		color: #fff;
		font: 600 0.92rem/1 var(--font-ui);
		text-decoration: none;
		cursor: pointer;
		transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
	}

	.oc-button:hover {
		background: var(--almasa-blue-hover);
		box-shadow: 0 10px 24px rgba(0, 58, 107, 0.22);
		transform: translateY(-1px);
	}

	.oc-button:focus-visible,
	.oc-role__apply:focus-visible,
	.oc-nav__links a:focus-visible {
		outline: 2px solid var(--serene-accent);
		outline-offset: 3px;
	}

	/* arrows point the reading direction */
	.oc-arrow {
		display: inline-block;
	}

	:global([dir='rtl']) .oc-arrow {
		transform: scaleX(-1);
	}

	/* ---- hero ---- */
	.oc-hero {
		padding-block: calc(var(--layout-section-space) * 0.7) 0;
	}

	.oc-hero__inner {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
		gap: clamp(28px, 5vw, 72px);
		align-items: center;
	}

	.oc-hero h1 {
		margin: 0 0 20px;
		font-family: var(--font-display);
		font-size: clamp(2.6rem, 5.2vw, 4.6rem);
		font-weight: 600;
		line-height: 1.02;
		letter-spacing: -0.5px;
		color: var(--almasa-blue);
	}

	.oc-hero__intro {
		max-inline-size: 30rem;
		margin: 0 0 30px;
		font-size: 1.05rem;
		line-height: 1.7;
		color: var(--text-secondary);
	}

	.oc-hero__visual {
		position: relative;
		padding: 0 0 18px 18px;
	}

	:global([dir='rtl']) .oc-hero__visual {
		padding: 0 18px 18px 0;
	}

	/* soft offset frame behind the photo */
	.oc-hero__visual::before {
		content: '';
		position: absolute;
		inset-block: 18px 0;
		inset-inline: 0 18px;
		border: 1px solid var(--surface-soft-border);
		border-radius: 18px;
		background: var(--surface-soft);
	}

	.oc-hero__frame {
		position: relative;
		overflow: hidden;
		aspect-ratio: 3 / 2;
		border-radius: 18px;
		box-shadow: 0 24px 60px rgba(0, 40, 80, 0.18);
	}

	.oc-hero__frame img {
		display: block;
		inline-size: 100%;
		block-size: 100%;
		object-fit: cover;
	}

	/* ---- open roles ---- */
	.oc-roles {
		padding-block: var(--layout-section-space) 0;
	}

	.oc-roles__list {
		display: grid;
		gap: var(--layout-card-gap);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.oc-role {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		padding: 24px 28px;
		border: 1px solid var(--border-subtle);
		border-radius: 14px;
		background: #fff;
		transition: border-color 0.2s ease, box-shadow 0.2s ease;
	}

	.oc-role:hover {
		border-color: var(--surface-soft-border);
		box-shadow: 0 12px 32px rgba(0, 58, 107, 0.08);
	}

	.oc-role__tag {
		display: inline-block;
		padding: 3px 10px;
		border: 1px solid var(--surface-soft-border);
		border-radius: 999px;
		background: var(--surface-soft);
		color: var(--almasa-blue);
		font-size: 0.7rem;
		font-weight: 600;
	}

	.oc-role__chips {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-block-end: 8px;
	}

	.oc-role__chip {
		padding: 3px 10px;
		border: 1px solid var(--border-subtle);
		border-radius: 999px;
		color: var(--text-muted);
		font-size: 0.7rem;
		font-weight: 500;
	}

	.oc-role h3 {
		margin: 0 0 4px;
		font-family: var(--font-display);
		font-size: 1.5rem;
		font-weight: 600;
		color: var(--almasa-blue);
	}

	.oc-role p {
		margin: 0;
		font-size: 0.92rem;
		color: var(--text-secondary);
	}

	.oc-role__apply {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		flex: none;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--serene-accent);
		text-decoration: none;
		white-space: nowrap;
	}

	.oc-role__apply:hover {
		color: var(--serene-accent-hover);
	}

	/* ---- application form ---- */
	.oc-apply {
		padding-block: var(--layout-section-space) 0;
		scroll-margin-block-start: 70px;
	}

	.oc-apply__inner {
		display: grid;
		grid-template-columns: 240px minmax(0, 1fr);
		gap: clamp(28px, 4vw, 56px);
		align-items: start;
	}

	.oc-apply__aside {
		position: sticky;
		inset-block-start: 84px;
	}

	.oc-progress {
		display: grid;
		gap: 4px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.oc-progress__item {
		display: flex;
		align-items: center;
		gap: 14px;
		padding-block: 10px;
		padding-inline: 14px;
		border-inline-start: 2px solid var(--border-subtle);
		font-size: 0.9rem;
		color: var(--text-muted);
		transition: color 0.2s ease, border-color 0.2s ease;
	}

	.oc-progress__item span {
		font-family: var(--font-display);
		font-size: 1.15rem;
		font-weight: 600;
	}

	.oc-progress__item.is-active {
		border-inline-start-color: var(--serene-accent);
		color: var(--almasa-blue);
		font-weight: 600;
	}

	.oc-form {
		display: grid;
		gap: 30px;
		padding: clamp(22px, 3.2vw, 40px);
		border: 1px solid var(--border-subtle);
		border-radius: 18px;
		background: #fff;
		box-shadow: 0 24px 60px rgba(0, 40, 80, 0.07);
	}

	.oc-notice {
		margin: 0;
		padding: 12px 16px;
		border: 1px solid var(--surface-soft-border);
		border-radius: 10px;
		background: var(--surface-soft);
		color: var(--almasa-blue);
		font-size: 0.85rem;
		font-weight: 500;
	}

	.oc-group {
		margin: 0;
		padding: 0;
		border: 0;
		min-inline-size: 0;
	}

	.oc-group legend {
		inline-size: 100%;
		margin: 0 0 16px;
		padding: 0 0 8px;
		border-block-end: 1px solid var(--border-subtle);
		font-family: var(--font-display);
		font-size: 1.3rem;
		font-weight: 600;
		color: var(--almasa-blue);
	}

	.oc-group__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 18px 20px;
	}

	.oc-field {
		display: grid;
		gap: 7px;
		align-content: start;
		min-inline-size: 0;
	}

	.oc-field--full {
		grid-column: 1 / -1;
	}

	.oc-field label,
	.oc-label {
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--text-secondary);
	}

	.oc-field i {
		margin-inline-start: 3px;
		font-style: normal;
		color: var(--serene-accent);
	}

	.oc-field input[type='text'],
	.oc-field input[type='email'],
	.oc-field input[type='tel'],
	.oc-field input[type='url'],
	.oc-field select,
	.oc-field textarea {
		inline-size: 100%;
		min-block-size: 48px;
		padding: 12px 14px;
		border: 1px solid var(--border-subtle);
		border-radius: 10px;
		background: #fff;
		color: var(--text-primary);
		font: 400 0.95rem/1.4 var(--font-ui);
		transition: border-color 0.2s ease, box-shadow 0.2s ease;
	}

	.oc-field textarea {
		resize: vertical;
	}

	.oc-field input:hover,
	.oc-field select:hover,
	.oc-field textarea:hover {
		border-color: rgba(8, 145, 178, 0.45);
	}

	.oc-field input:focus-visible,
	.oc-field select:focus-visible,
	.oc-field textarea:focus-visible {
		outline: none;
		border-color: var(--serene-accent);
		box-shadow: 0 0 0 4px rgba(8, 145, 178, 0.16);
	}

	/* CV drop zone */
	.oc-drop {
		position: relative;
		display: grid;
		justify-items: center;
		gap: 6px;
		padding: 30px 20px;
		border: 1.5px dashed rgba(8, 145, 178, 0.5);
		border-radius: 14px;
		background: var(--surface-soft);
		color: var(--almasa-blue);
		text-align: center;
		cursor: pointer;
