---
interface Props {
	locale?: 'en' | 'ar';
	currentPath?: string;
}

void Astro.props satisfies Props;
---

<div class="site-shell">
	<a class="site-shell__skip-link" href="#main-content">Skip to main content</a>
	<main id="main-content" tabindex="-1">
		<slot />
	</main>
</div>

<style>
	.site-shell {
		min-block-size: 100vh;
		background: #fff;
	}

	.site-shell__skip-link {
		position: fixed;
		z-index: 10000;
		inset-block-start: 12px;
		inset-inline-start: 12px;
		padding: 10px 14px;
		background: #003a6b;
		color: #fff;
		font: 600 14px/1.2 'Inter', 'Segoe UI', Arial, sans-serif;
		text-decoration: none;
		transform: translateY(-150%);
	}

	.site-shell__skip-link:focus-visible {
		transform: translateY(0);
		outline: 2px solid #0891b2;
		outline-offset: 2px;
	}

	main {
		min-block-size: 100vh;
	}
</style>
