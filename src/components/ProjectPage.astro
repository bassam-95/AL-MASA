---
import SiteFooter from './SiteFooter.astro';
import * as projectsData from '../data/projects';
import * as showcaseLabels from '../data/showcase-labels';

const slug = Astro.props.slug;
const locale = 'en';
const project = projectsData.projectBySlug(slug);
if (!project) throw new Error('Unknown project slug: ' + slug);

const statusLabel = showcaseLabels.statusLabels[locale][project.status];
const scaleLabel = project.scale === 'mega' ? 'Mega project' : 'Project';
// English names come from the current website where it has one; every other name is shown as supplied (Arabic).
const displayName = project.nameEn ?? project.nameAr;
const nameLang = project.nameEn ? 'en' : 'ar';
const nameDir = project.nameEn ? 'ltr' : 'rtl';

const cover = project.showcaseImage
	? { src: project.showcaseImage.src, width: project.showcaseImage.width, height: project.showcaseImage.height }
	: project.photos[0];
const film = project.films[0];
const gallery = project.photos;
const hasMedia = Boolean(cover || film);

const coverOf = (item) => (item.showcaseImage ? item.showcaseImage : item.photos[0]);
const related = projectsData.projects
	.filter((item) => item.publish && item.id !== project.id && coverOf(item))
	.sort((a, b) => Number(b.status === project.status) - Number(a.status === project.status) || Number(b.scale === project.scale) - Number(a.scale === project.scale) || a.id - b.id)
	.slice(0, 3);
const nameOf = (item) => item.nameEn ?? item.nameAr;
const langOf = (item) => (item.nameEn ? 'en' : 'ar');

const facts = [
	{ label: 'Status', value: statusLabel },
	{ label: 'Category', value: scaleLabel },
	{ label: 'Location', value: project.locationAr, lang: 'ar' },
	{ label: 'Client', value: '' },
	{ label: 'Area', value: '' },
	{ label: 'Year', value: '' },
];
---

<div class="owner-project-page" data-project-page>
	<header class="pp-nav" aria-label="Navigation">
		<div class="owner-container pp-nav__inner">
			<a class="pp-brand" href="/en/" aria-label="AL MASA">
				<img src="/assets/owner-confirmed/brand/logo-primary.png" alt="AL MASA" width="85" height="40" />
				<span>AL MASA</span>
			</a>
			<nav class="pp-nav__links" aria-label="Links">
				<a href="/en/">Home</a>
				<a href="/en/projects/">All projects</a>
				<a href="/en/about/">About</a>
				<a href="/en/contact/">Contact</a>
			</nav>
		</div>
	</header>

	<section class="pp-hero" aria-labelledby="pp-title">
		<div class="owner-container">
			<div class:list={['pp-hero__frame', { 'is-empty': !cover }]}>
				{cover ? (
					<img src={cover.src} alt={displayName} width={cover.width} height={cover.height} loading="eager" decoding="async" />
				) : (
					<img class="pp-hero__mark" src="/assets/owner-confirmed/brand/logo-primary.png" alt="" width="170" height="80" />
				)}
				<div class="pp-hero__caption">
					<p class="pp-chips">
						<span>{statusLabel}</span>
						<span>{scaleLabel}</span>
					</p>
					<h1 id="pp-title" lang={nameLang} dir={nameDir}>{displayName}</h1>
				</div>
			</div>
		</div>
	</section>

	<section class="pp-section" aria-label="Project details">
		<div class="owner-container pp-details">
			<div class="pp-overview">
				<h2 class="pp-heading">Overview</h2>
				<p class="pp-placeholder">The project description will be added here once the details are confirmed.</p>
				{!hasMedia && <p class="pp-placeholder">Photos and video for this project will be added soon.</p>}
			</div>
			<dl class="pp-facts">
				{
					facts.map((fact) => (
						<div class="pp-fact">
							<dt>{fact.label}</dt>
							{fact.value ? <dd lang={fact.lang} dir={fact.lang === 'ar' ? 'rtl' : undefined}>{fact.value}</dd> : <dd class="pp-fact__pending">To be confirmed</dd>}
						</div>
					))
				}
			</dl>
		</div>
	</section>

	{
		film && (
			<section class="pp-section" aria-labelledby="pp-film-title">
				<div class="owner-container">
					<h2 class="pp-heading" id="pp-film-title">Project film</h2>
					<div class="pp-film">
						<video controls playsinline preload="metadata" poster={film.poster} aria-label={'Project film: ' + displayName}>
							<source src={film.src} type="video/mp4" />
						</video>
					</div>
					{film.isHeroClip && <p class="pp-note">Preview clip. The full-length film will replace it.</p>}
				</div>
			</section>
		)
	}

	{
		gallery.length > 0 && (
			<section class="pp-section" aria-labelledby="pp-gallery-title">
				<div class="owner-container">
					<h2 class="pp-heading" id="pp-gallery-title">Gallery</h2>
					<ul class="pp-gallery">
						{
							gallery.map((photo, index) => (
								<li>
									<button type="button" class="pp-gallery__item" data-pp-open={index} aria-label={'Open photo ' + (index + 1) + ' of ' + gallery.length}>
										<img src={photo.src} alt={displayName + ' photo ' + (index + 1)} width={photo.width} height={photo.height} loading="lazy" decoding="async" />
									</button>
								</li>
							))
						}
					</ul>
					<p class="pp-note">Draft photo selection, pending approval.</p>
				</div>
			</section>
		)
	}

	{
		related.length > 0 && (
			<section class="pp-section" aria-labelledby="pp-related-title">
				<div class="owner-container">
					<h2 class="pp-heading" id="pp-related-title">More projects</h2>
					<ul class="pp-related">
						{
							related.map((item) => (
								<li>
									<a class="pp-related__card" href={'/en/projects/' + item.slug + '/'}>
										<img src={coverOf(item).src} alt="" width={coverOf(item).width} height={coverOf(item).height} loading="lazy" decoding="async" />
										<span lang={langOf(item)} dir={langOf(item) === 'ar' ? 'rtl' : 'ltr'}>{nameOf(item)}</span>
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</section>
		)
	}

	<dialog class="pp-lightbox" data-pp-lightbox aria-label="Photo viewer">
		<button type="button" class="pp-lightbox__close" data-pp-close aria-label="Close">&times;</button>
		<button type="button" class="pp-lightbox__nav pp-lightbox__nav--prev" data-pp-prev aria-label="Previous photo">&lsaquo;</button>
		<img class="pp-lightbox__img" data-pp-img alt="" />
		<button type="button" class="pp-lightbox__nav pp-lightbox__nav--next" data-pp-next aria-label="Next photo">&rsaquo;</button>
	</dialog>

	<script is:inline type="application/json" data-pp-photos set:html={JSON.stringify(gallery.map((photo) => photo.src))} />
	<SiteFooter />
</div>

<script>
	const root = document.querySelector('[data-project-page]');
	const dialog = root?.querySelector('[data-pp-lightbox]');
	const dataEl = root?.querySelector('[data-pp-photos]');
	if (root && dialog instanceof HTMLDialogElement && dataEl) {
		const photos = JSON.parse(dataEl.textContent || '[]');
		const img = dialog.querySelector('[data-pp-img]');
		let current = 0;
		const show = (index) => {
			current = (index + photos.length) % photos.length;
			if (img instanceof HTMLImageElement) img.src = photos[current];
		};
		root.querySelectorAll('[data-pp-open]').forEach((button) => {
			button.addEventListener('click', () => {
				show(Number(button.getAttribute('data-pp-open')));
				dialog.showModal();
			});
		});
		dialog.querySelector('[data-pp-close]')?.addEventListener('click', () => dialog.close());
		dialog.querySelector('[data-pp-prev]')?.addEventListener('click', () => show(current - 1));
		dialog.querySelector('[data-pp-next]')?.addEventListener('click', () => show(current + 1));
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close();
		});
		dialog.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft') show(current - 1);
			if (event.key === 'ArrowRight') show(current + 1);
		});
	}
</script>

<style>
	.owner-project-page {
		--bg-main: #ffffff;
		--surface-soft: #e8f6fe;
		--surface-soft-border: rgba(8, 145, 178, 0.16);
		--serene-accent: #0891b2;
		--almasa-blue: #003a6b;
		--text-primary: #0f172a;
		--text-secondary: #475569;
		--text-muted: #64748b;
		--border-subtle: #e2e8f0;
		--font-display: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
		--font-ui: 'Inter', 'Segoe UI', Arial, sans-serif;
		min-block-size: 100vh;
		background: var(--bg-main);
		color: var(--text-primary);
		font-family: var(--font-ui);
		overflow-x: clip;
	}

	.owner-project-page *,
	.owner-project-page *::before,
	.owner-project-page *::after {
		box-sizing: border-box;
	}

	/* ---- header (same look as the homepage nav) ---- */
	.pp-nav {
		position: sticky;
		inset-block-start: 0;
		z-index: 100;
		block-size: 54px;
		display: flex;
		align-items: center;
		background: rgba(255, 255, 255, 0.96);
		border-block-end: 1px solid rgba(8, 145, 178, 0.12);
		backdrop-filter: blur(14px);
	}

	.pp-nav__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
	}

	.pp-brand {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		color: var(--almasa-blue);
		text-decoration: none;
	}

	.pp-brand img {
		inline-size: auto;
		block-size: 26px;
		object-fit: contain;
	}

	.pp-brand span {
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 700;
		letter-spacing: 1.5px;
		text-transform: uppercase;
	}

	.pp-nav__links {
		display: flex;
		align-items: center;
		gap: 22px;
	}

	.pp-nav__links a {
		font-size: 0.82rem;
		font-weight: 500;
		color: var(--text-secondary);
		text-decoration: none;
		white-space: nowrap;
		transition: color 0.2s ease;
	}

	.pp-nav__links a:hover {
		color: var(--serene-accent);
	}

	/* ---- hero ---- */
	.pp-hero {
		padding-block-start: 16px;
	}

	.pp-hero__frame {
		position: relative;
		overflow: hidden;
		border: 1px solid var(--surface-soft-border);
		border-radius: 8px;
		background: #001224;
		aspect-ratio: 16 / 7;
		max-block-size: calc(100svh - 94px);
		min-block-size: 280px;
	}

	.pp-hero__frame > img:not(.pp-hero__mark) {
		position: absolute;
		inset: 0;
		inline-size: 100%;
		block-size: 100%;
		object-fit: cover;
	}

	.pp-hero__frame.is-empty {
		background: var(--surface-soft);
		border-color: var(--surface-soft-border);
	}

	.pp-hero__mark {
		position: absolute;
		inset-block-start: 50%;
		inset-inline-start: 50%;
		translate: -50% -70%;
		inline-size: 150px;
		block-size: auto;
		opacity: 0.5;
	}

	.pp-hero__caption {
		position: absolute;
		inset-inline: 0;
		inset-block-end: 0;
		z-index: 2;
		padding: 4rem 2.25rem 1.6rem;
		color: #fff;
		background: linear-gradient(180deg, rgba(0, 18, 36, 0) 0%, rgba(0, 18, 36, 0.62) 100%);
	}

	.is-empty .pp-hero__caption {
		background: none;
		color: var(--almasa-blue);
	}

	.pp-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 0 0 10px;
	}

	.pp-chips span {
		padding: 3px 11px;
		border: 1px solid rgba(255, 255, 255, 0.55);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.1);
		backdrop-filter: blur(6px);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.8px;
		text-transform: uppercase;
	}

	.is-empty .pp-chips span {
		border-color: var(--surface-soft-border);
		background: #fff;
		color: var(--almasa-blue);
	}

	.pp-hero h1 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.8rem, 3.4vw, 3rem);
		font-weight: 600;
		line-height: 1.12;
		letter-spacing: 0.2px;
	}

	/* ---- sections ---- */
	.pp-section {
		padding-block-start: var(--layout-section-space);
	}

	.pp-heading {
		margin: 0 0 22px;
		padding-block-end: 8px;
		border-block-end: 1px solid var(--border-subtle);
		font-family: var(--font-display);
		font-size: 1.45rem;
		font-weight: 600;
		line-height: 1.2;
		letter-spacing: 0.2px;
		color: var(--almasa-blue);
	}

	.pp-details {
		display: grid;
		grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
		gap: clamp(28px, 5vw, 80px);
		align-items: start;
	}

	.pp-placeholder,
	.pp-note {
		margin: 0 0 10px;
		color: var(--text-muted);
		font-size: 0.95rem;
		line-height: 1.6;
	}

	.pp-note {
		margin-block-start: 14px;
		font-size: 0.8rem;
	}

	.pp-facts {
		margin: 0;
		padding: 6px 22px;
		border: 1px solid var(--surface-soft-border);
		border-radius: 8px;
		background: var(--surface-soft);
	}

	.pp-fact {
		display: flex;
		justify-content: space-between;
		gap: 18px;
		padding: 14px 0;
		border-block-end: 1px solid rgba(8, 145, 178, 0.14);
	}

	.pp-fact:last-child {
		border-block-end: 0;
	}

	.pp-fact dt {
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 1.2px;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.pp-fact dd {
		margin: 0;
		font-size: 0.95rem;
		font-weight: 500;
		color: var(--almasa-blue);
		text-align: end;
	}

	.pp-fact .pp-fact__pending {
		font-weight: 400;
		color: var(--text-muted);
	}

	/* ---- film ---- */
	.pp-film {
		overflow: hidden;
		border: 1px solid var(--surface-soft-border);
		border-radius: 8px;
		background: #001224;
		aspect-ratio: 16 / 9;
		max-block-size: calc(100svh - 120px);
		margin-inline: auto;
	}

	.pp-film video {
		display: block;
		inline-size: 100%;
		block-size: 100%;
		object-fit: contain;
		background: #001224;
	}

	/* ---- gallery ---- */
	.pp-gallery {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: var(--layout-card-gap);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.pp-gallery__item {
		display: block;
		inline-size: 100%;
		padding: 0;
		border: 0;
		border-radius: 8px;
		background: var(--surface-soft);
		overflow: hidden;
		cursor: zoom-in;
		aspect-ratio: 3 / 2;
	}

	.pp-gallery__item img {
		display: block;
		inline-size: 100%;
		block-size: 100%;
		object-fit: cover;
		transition: transform 0.5s ease;
	}

	.pp-gallery__item:hover img,
	.pp-gallery__item:focus-visible img {
		transform: scale(1.04);
	}

	/* ---- related ---- */
	.pp-related {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--layout-card-gap);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.pp-related__card {
		position: relative;
		display: block;
		overflow: hidden;
		border-radius: 8px;
		aspect-ratio: 3 / 2;
		color: #fff;
		text-decoration: none;
	}

	.pp-related__card img {
		position: absolute;
		inset: 0;
		inline-size: 100%;
		block-size: 100%;
		object-fit: cover;
		transition: transform 0.5s ease;
	}

	.pp-related__card:hover img {
		transform: scale(1.04);
	}

	.pp-related__card span {
		position: absolute;
		inset-inline: 0;
		inset-block-end: 0;
		padding: 2.2rem 20px 16px;
		background: linear-gradient(to top, rgba(0, 16, 36, 0.72), transparent);
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 600;
		line-height: 1.25;
	}

	/* ---- lightbox ---- */
	.pp-lightbox {
		inline-size: 100vw;
		block-size: 100vh;
		block-size: 100dvh;
		max-inline-size: none;
		max-block-size: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: rgba(0, 12, 26, 0.94);
	}

	.pp-lightbox[open] {
		display: grid;
		place-items: center;
	}

	.pp-lightbox__img {
		max-inline-size: 92vw;
		max-block-size: 88vh;
		object-fit: contain;
	}

	.pp-lightbox__close,
	.pp-lightbox__nav {
		position: absolute;
		display: grid;
		place-items: center;
		inline-size: 44px;
		block-size: 44px;
		border: 1px solid rgba(255, 255, 255, 0.4);
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.08);
		color: #fff;
		font-size: 1.6rem;
		line-height: 1;
		cursor: pointer;
	}

	.pp-lightbox__close {
		inset-block-start: 18px;
		inset-inline-end: 18px;
	}

	.pp-lightbox__nav {
		inset-block-start: 50%;
		translate: 0 -50%;
	}

	.pp-lightbox__nav--prev {
		inset-inline-start: 18px;
	}

	.pp-lightbox__nav--next {
		inset-inline-end: 18px;
	}

	.pp-nav a:focus-visible,
	.pp-gallery__item:focus-visible,
	.pp-related__card:focus-visible {
		outline: 2px solid var(--serene-accent);
		outline-offset: 3px;
	}

	@media (max-width: 860px) {
		.pp-hero__frame {
			aspect-ratio: 4 / 5;
			max-block-size: none;
			min-block-size: 0;
		}

		.pp-hero__caption {
			padding: 3rem 16px 1.2rem;
		}

		.pp-details {
			grid-template-columns: minmax(0, 1fr);
		}

		.pp-gallery {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.pp-related {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
