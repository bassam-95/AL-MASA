---
import * as educationalData from '../data/educational';

const locale = Astro.props.locale;
const labels = educationalData.educationalLabels[locale];
const videos = educationalData.educationalVideos;
const featured = videos[0];
const rest = videos.slice(1, 4);
---

{
	videos.length > 0 && (
		<section class="owner-edu" aria-labelledby="owner-edu-title" data-owner-edu>
			<div class="owner-container">
				<header class="owner-edu__header">
					<h2 id="owner-edu-title">{labels.title}</h2>
					<a class="owner-edu__view-all" href="#owner-edu-title">
						<span>{labels.viewAll}</span>
						<span class="owner-edu__arrow" aria-hidden="true">&rarr;</span>
					</a>
				</header>

				<div class="owner-edu__layout">
					<article class="owner-edu__featured">
						<div class="owner-edu__media owner-edu__media--featured">
							{
								featured.video ? (
									<video controls preload="none" poster={featured.poster || undefined} aria-label={featured.title[locale]}>
										<source src={featured.video} type="video/mp4" />
									</video>
								) : (
									<span class="owner-edu__play" aria-hidden="true">
										<svg viewBox="0 0 24 24" width="28" height="28" focusable="false"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
									</span>
								)
							}
							<span class="owner-edu__badge">{labels.latest}</span>
						</div>
						<div class="owner-edu__body">
							<p class="owner-edu__meta">
								<span>{featured.category[locale]}</span>
								{featured.isSample && <span class="owner-edu__chip">{labels.sample}</span>}
							</p>
							<h3>{featured.title[locale]}</h3>
						</div>
					</article>

					<ul class="owner-edu__list">
						{
							rest.map((item) => (
								<li class="owner-edu__item">
									<div class="owner-edu__media owner-edu__media--thumb">
										{
											item.video ? (
												<video controls preload="none" poster={item.poster || undefined} aria-label={item.title[locale]}>
													<source src={item.video} type="video/mp4" />
												</video>
											) : (
												<span class="owner-edu__play owner-edu__play--small" aria-hidden="true">
													<svg viewBox="0 0 24 24" width="18" height="18" focusable="false"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
												</span>
											)
										}
									</div>
									<div class="owner-edu__body">
										<p class="owner-edu__meta">
											<span>{item.category[locale]}</span>
											{item.isSample && <span class="owner-edu__chip">{labels.sample}</span>}
										</p>
										<h3>{item.title[locale]}</h3>
									</div>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</section>
	)
}

<style>
	/* Spacing comes from the --layout-* tokens in src/styles/global.css. */
	.owner-edu {
		padding-block: var(--layout-section-space) 0;
	}

	.owner-edu__header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 18px;
		margin-block-end: 20px;
		padding-block-end: 8px;
		border-block-end: 1px solid var(--border-subtle, #e2e8f0);
	}

	.owner-edu__header h2 {
		margin: 0;
		font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif);
		font-size: 1.45rem;
		font-weight: 600;
		line-height: 1.2;
		letter-spacing: 0.2px;
		color: var(--almasa-blue, #003a6b);
	}

	.owner-edu__view-all {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		font-family: var(--font-ui, 'Inter', sans-serif);
		font-size: 0.82rem;
		font-weight: 500;
		color: var(--serene-accent, #0891b2);
		text-decoration: none;
		white-space: nowrap;
		transition: color 0.2s ease, transform 0.2s ease;
	}

	.owner-edu__view-all:hover {
		color: var(--serene-accent-hover, #0e7490);
		transform: translateX(2px);
	}

	:global([dir="rtl"]) .owner-edu__view-all:hover {
		transform: translateX(-2px);
	}

	:global([dir="rtl"]) .owner-edu__arrow {
		display: inline-block;
		transform: scaleX(-1);
	}

	/* Newest video is large, the next three sit beside it. */
	.owner-edu__layout {
		display: grid;
		grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
		gap: var(--layout-card-gap);
		align-items: start;
	}

	.owner-edu__featured {
		min-inline-size: 0;
	}

	.owner-edu__list {
		display: grid;
		gap: var(--layout-card-gap);
		margin: 0;
		padding: 0;
		list-style: none;
		min-inline-size: 0;
	}

	.owner-edu__item {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
		gap: 14px;
		align-items: center;
		min-inline-size: 0;
	}

	/* Placeholder tile in the brand palette. Replaced by a poster/video as soon
	   as an entry has real media. */
	.owner-edu__media {
		position: relative;
		display: grid;
		place-items: center;
		overflow: hidden;
		aspect-ratio: 16 / 9;
		border-radius: 12px;
		background:
			radial-gradient(120% 90% at 85% 0%, rgba(8, 145, 178, 0.55) 0%, rgba(8, 145, 178, 0) 60%),
			linear-gradient(135deg, #003a6b 0%, #0b5b8f 100%);
		box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06);
	}

	.owner-edu__media video {
		position: absolute;
		inset: 0;
		inline-size: 100%;
		block-size: 100%;
		object-fit: cover;
		background: #000;
	}

	.owner-edu__play {
		display: grid;
		place-items: center;
		inline-size: 64px;
		block-size: 64px;
		border-radius: 50%;
		color: #003a6b;
		background: rgba(255, 255, 255, 0.92);
		box-shadow: 0 8px 24px rgba(0, 24, 48, 0.28);
	}

	/* The play triangle must not mirror in right-to-left pages. */
	.owner-edu__play svg {
		transform: none;
		margin-inline-start: 3px;
	}

	.owner-edu__play--small {
		inline-size: 36px;
		block-size: 36px;
	}

	.owner-edu__badge {
		position: absolute;
		inset-block-start: 12px;
		inset-inline-start: 12px;
		padding: 4px 10px;
		border-radius: 999px;
		font-family: var(--font-ui, 'Inter', sans-serif);
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.4px;
		color: #003a6b;
		background: rgba(255, 255, 255, 0.92);
	}

	.owner-edu__body {
		min-inline-size: 0;
	}

	.owner-edu__featured .owner-edu__body {
		padding-block-start: 14px;
	}

	.owner-edu__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		margin: 0 0 6px;
		font-family: var(--font-ui, 'Inter', sans-serif);
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--serene-accent, #0891b2);
	}

	.owner-edu__chip {
		padding: 2px 8px;
		border: 1px solid var(--surface-soft-border, rgba(8, 145, 178, 0.16));
		border-radius: 999px;
		background: var(--surface-soft, #e8f6fe);
		color: var(--almasa-blue, #003a6b);
		font-size: 0.68rem;
		font-weight: 600;
	}

	.owner-edu h3 {
		margin: 0;
		font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif);
		font-size: 1.2rem;
		font-weight: 600;
		line-height: 1.25;
		color: var(--almasa-blue, #003a6b);
	}

	.owner-edu__featured h3 {
		font-size: 1.55rem;
	}

	@media (max-width: 860px) {
		.owner-edu__header {
			gap: 6px 12px;
			margin-block-end: 14px;
		}

		.owner-edu__header h2 {
			font-size: 1.35rem;
		}

		.owner-edu__layout {
			grid-template-columns: minmax(0, 1fr);
		}

		.owner-edu__featured h3 {
			font-size: 1.35rem;
		}

		.owner-edu__play {
			inline-size: 56px;
			block-size: 56px;
		}

		.owner-edu__play--small {
			inline-size: 32px;
			block-size: 32px;
		}
	}
</style>
