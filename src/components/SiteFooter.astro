---
import { company } from '../data/site';

const year = new Date().getFullYear();
const links = [
	{ label: 'Projects', href: '/en/projects/' },
	{ label: 'About', href: '/en/about/' },
	{ label: 'Approach', href: '/en/approach/' },
	{ label: 'Careers', href: '/en/careers/apply/' },
	{ label: 'Contact', href: '/en/contact/' },
];
---

<footer class="sf" aria-label="Site footer">
	<div class="owner-container sf__inner">
		<div class="sf__brand">
			<a class="sf__logo" href="/en/" aria-label="AL MASA">
				<img src="/assets/owner-confirmed/brand/logo-primary.png" alt="" width="85" height="40" loading="lazy" />
				<span>AL MASA</span>
			</a>
			<p>General contracting since {company.founded}.</p>
		</div>

		<nav class="sf__col" aria-label="Footer links">
			<h2>Explore</h2>
			<ul>
				{links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
			</ul>
		</nav>

		<div class="sf__col">
			<h2>Offices</h2>
			<ul>
				{company.offices.map((office) => <li>{office}</li>)}
			</ul>
		</div>

		<div class="sf__col">
			<h2>Contact</h2>
			<ul>
				<li><a href={'mailto:' + company.email}>{company.email}</a></li>
			</ul>
			<ul class="sf__social">
				{company.social.map((item) => <li><a href={item.href} target="_blank" rel="noopener noreferrer">{item.label}</a></li>)}
			</ul>
		</div>
	</div>
	<div class="owner-container sf__legal">
		<small>&copy; {year} {company.longName}</small>
	</div>
</footer>

<style>
	.sf {
		margin-block-start: var(--layout-section-space, 88px);
		padding-block: 48px 24px;
		background: #e8f6fe;
		border-block-start: 1px solid rgba(8, 145, 178, 0.16);
		color: #475569;
		font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
	}

	.sf__inner {
		display: grid;
		grid-template-columns: 1.3fr 1fr 1.4fr 1.3fr;
		gap: clamp(24px, 4vw, 64px);
	}

	.sf__logo {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		color: #003a6b;
		text-decoration: none;
	}

	.sf__logo img {
		inline-size: auto;
		block-size: 28px;
		object-fit: contain;
	}

	.sf__logo span {
		font-family: 'Cormorant Garamond', Georgia, serif;
		font-size: 1.3rem;
		font-weight: 700;
		letter-spacing: 1.5px;
	}

	.sf__brand p {
		margin: 14px 0 0;
		font-size: 0.88rem;
		line-height: 1.6;
	}

	.sf h2 {
		margin: 0 0 14px;
		font-size: 0.74rem;
		font-weight: 600;
		letter-spacing: 1.4px;
		text-transform: uppercase;
		color: #003a6b;
	}

	.sf ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 8px;
		font-size: 0.88rem;
		line-height: 1.5;
	}

	.sf__social {
		margin-block-start: 14px;
		display: flex;
		gap: 16px;
	}

	.sf a {
		color: inherit;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.sf a:hover,
	.sf a:focus-visible {
		color: #0891b2;
	}

	.sf__legal {
		margin-block-start: 36px;
		padding-block-start: 16px;
		border-block-start: 1px solid rgba(8, 145, 178, 0.18);
		font-size: 0.78rem;
		color: #64748b;
	}

	@media (max-width: 860px) {
		.sf {
			padding-block: 36px 20px;
		}

		.sf__inner {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		}

		.sf__brand {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 520px) {
		.sf__inner {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
