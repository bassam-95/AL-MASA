---
import { homeContent } from '../data/home';
import type { Locale } from '../data/locales';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const content = homeContent[locale];
const isArabic = locale === 'ar';
---

<div class="home-page" data-home-page data-locale={locale}>
	<section class="home-hero" aria-label={isArabic ? 'عرض الصفحة الرئيسية' : 'Homepage showcase'} data-hero-slider>
		<div class="home-hero__slides">
			{content.slides.map((slide, index) => (
				<article class:list={["home-hero__slide", { 'is-active': index === 0 }]} data-hero-slide aria-hidden={index === 0 ? 'false' : 'true'}>
					<img class="home-hero__image" src={slide.image} alt={slide.alt} width="1440" height="760" loading={index === 0 ? 'eager' : 'lazy'} />
					<div class="home-hero__overlay" aria-hidden="true"></div>
					<div class="home-hero__content">
						<h1>{slide.title.split('\n').map((line) => <><span>{line}</span><br /></>)}</h1>
						<p>{slide.text}</p>
						<a class="home-button home-button--light" href="#services">{slide.cta}</a>
					</div>
				</article>
			))}
		</div>
		<div class="home-hero__controls" aria-label={isArabic ? 'تحكم العرض' : 'Slider controls'}>
			<button class="home-hero__arrow" type="button" data-hero-prev aria-label={isArabic ? 'الشريحة السابقة' : 'Previous slide'}>‹</button>
			<div class="home-hero__dots" role="tablist" aria-label={isArabic ? 'اختيار الشريحة' : 'Choose slide'}>
				{content.slides.map((slide, index) => (
					<button
						class:list={["home-hero__dot", { 'is-active': index === 0 }]}
						type="button"
						data-hero-dot={index}
						aria-label={`${isArabic ? 'الشريحة' : 'Slide'} ${index + 1}: ${slide.title.replace('\n', ' ')}`}
						aria-selected={index === 0 ? 'true' : 'false'}
					></button>
				))}
			</div>
			<button class="home-hero__arrow" type="button" data-hero-next aria-label={isArabic ? 'الشريحة التالية' : 'Next slide'}>›</button>
		</div>
	</section>

	<section id="services" class="home-section home-section--services" aria-labelledby="services-heading">
		<div class="home-container home-section__intro">
			<h2 id="services-heading">{content.services.title}</h2>
			<p>{content.services.intro}</p>
		</div>
		<div class="home-container home-services">
			{content.services.items.map((service) => (
				<article class="home-service-card">
					<img src={service.image} alt="" width="640" height="427" loading="lazy" />
					<div class="home-service-card__body">
						<h3>{service.title}</h3>
						<p>{service.text}</p>
					</div>
				</article>
			))}
		</div>
	</section>

	<section class="home-stats" aria-label={isArabic ? 'إحصائيات الشركة' : 'Company statistics'}>
		<div class="home-container home-stats__grid">
			{content.stats.map((stat) => (
				<div class="home-stat">
					<span class="home-stat__number"><span data-counter data-target={stat.value}>{stat.value}</span>{stat.suffix}</span>
					<span class="home-stat__label">{stat.label}</span>
				</div>
			))}
		</div>
	</section>

	<section class="home-section home-section--projects" aria-labelledby="projects-heading">
		<div class="home-container home-section__intro">
			<h2 id="projects-heading">{content.projects.title}</h2>
			{content.projects.intro && <p>{content.projects.intro}</p>}
		</div>
		<div
			class="home-projects"
			aria-label={content.projects.title}
			aria-roledescription="carousel"
			data-projects-carousel
			data-carousel="projects"
			data-carousel-loop="true"
			tabindex="0"
		>
			<button class="home-carousel-button home-projects__button home-projects__button--prev" type="button" data-carousel-prev="projects" aria-label={isArabic ? 'المشروع السابق' : 'Previous project'}>
				<span aria-hidden="true">‹</span>
				<span>{isArabic ? 'السابق' : 'Previous'}</span>
			</button>
			<div class="home-projects__viewport">
				<div class="home-projects__track" data-carousel-track="projects" aria-live="polite">
					{content.projects.items.map((project, index) => (
						<article
							class:list={["home-project-slide", { 'is-active': index === 0, 'is-prev': index === content.projects.items.length - 1, 'is-next': index === 1 }]}
							data-carousel-slide="projects"
							aria-roledescription="slide"
							aria-label={`${index + 1} / ${content.projects.items.length}`}
							aria-hidden={index === 0 ? 'false' : 'true'}
						>
							<a class="home-project-card" href={project.url} target="_blank" rel="noreferrer">
								<img src={project.image} alt="" width="1280" height="572" loading="lazy" />
								<span>{project.title}</span>
							</a>
						</article>
					))}
				</div>
			</div>
			<button class="home-carousel-button home-projects__button home-projects__button--next" type="button" data-carousel-next="projects" aria-label={isArabic ? 'المشروع التالي' : 'Next project'}>
				<span>{isArabic ? 'التالي' : 'Next'}</span>
				<span aria-hidden="true">›</span>
			</button>
		</div>
	</section>

	<section class="home-about" aria-labelledby="about-heading">
		<div class="home-container home-about__grid">
			<div class="home-about__brand-mark" aria-hidden="true">
				<img src="/assets/almasa-logo.png" alt="" width="717" height="336" loading="lazy" />
			</div>
			<div class="home-about__content">
				<p class="home-eyebrow">{content.about.eyebrow}</p>
				<h2 id="about-heading">{content.about.title}</h2>
				<p>{content.about.text}</p>
				<div class="home-about__phones" aria-label={isArabic ? 'أرقام الهاتف' : 'Phone numbers'}>
					{content.about.phones.map((phone) => <a href={`tel:${phone}`}>{phone}</a>)}
				</div>
				<div class="home-about__features">
					{content.about.features.map((feature) => (
						<article class="home-feature">
							<span class="home-feature__icon" aria-hidden="true">
								{feature.icon === 'clock' ? '24' : '$'}
							</span>
							<div>
								<h3>{feature.title}</h3>
								<p>{feature.text}</p>
							</div>
						</article>
					))}
				</div>
			</div>
		</div>
	</section>

	<section class="home-section home-section--news" aria-labelledby="news-heading">
		<div class="home-container home-section__intro">
			<h2 id="news-heading">{content.news.title}</h2>
			<p>{content.news.intro}</p>
		</div>
		<div class="home-container home-news">
			{content.news.items.map((item) => (
				<article class="home-news-card">
					<img src={item.image} alt="" width="150" height="150" loading="lazy" />
					<div>
						<time>{item.date}</time>
						<h3><a href={item.url} target="_blank" rel="noreferrer">{item.title}</a></h3>
						<p>{item.excerpt}</p>
						<a class="home-text-link" href={item.url} target="_blank" rel="noreferrer">{item.readMore}</a>
					</div>
				</article>
			))}
		</div>
		<div class="home-section__action">
			<a class="home-button" href={locale === 'en' ? 'https://almasa-ta.com/blog/' : 'https://almasa-ta.com/ar/blog/'} target="_blank" rel="noreferrer">{content.news.readAll}</a>
		</div>
	</section>

	<section
		class="home-partners"
		aria-labelledby="partners-heading"
		data-partners-carousel
		data-carousel="partners"
		data-carousel-loop="true"
		data-carousel-autoplay="2000"
		data-carousel-start="5"
	>
		<div class="home-container">
			<h2 id="partners-heading">{content.partners.title}</h2>
		</div>
		<div class="home-partners__carousel" aria-label={content.partners.title} aria-roledescription="carousel" tabindex="0">
			<button class="home-carousel-button home-partners__button home-partners__button--prev" type="button" data-carousel-prev="partners" aria-label={isArabic ? 'الشريك السابق' : 'Previous partner'}>‹</button>
			<div class="home-partners__viewport">
				<div class="home-partners__track" data-carousel-track="partners" aria-live="off">
					{content.partners.items.map((partner, index) => (
						<div
							class:list={["home-partner-logo", { 'is-active': index === 5, 'is-prev': index === 4, 'is-next': index === 6 }]}
							data-carousel-slide="partners"
							role="group"
							aria-roledescription="slide"
							aria-label={`${index + 1} / ${content.partners.items.length}: ${partner.name}`}
							aria-hidden={index === 5 || index === 4 || index === 6 ? 'false' : 'true'}
						>
							<img src={partner.image} alt={partner.name} width="150" height="150" loading="lazy" />
						</div>
					))}
				</div>
			</div>
			<button class="home-carousel-button home-partners__button home-partners__button--next" type="button" data-carousel-next="partners" aria-label={isArabic ? 'الشريك التالي' : 'Next partner'}>›</button>
			<div class="home-partners__dots" aria-label={isArabic ? 'اختيار الشريك' : 'Choose partner'}>
				{content.partners.items.map((partner, index) => (
					<button
						class:list={["home-partners__dot", { 'is-active': index === 5 }]}
						type="button"
						data-carousel-dot="partners"
						data-carousel-index={index}
						aria-label={`${isArabic ? 'الشريك' : 'Partner'} ${index + 1}: ${partner.name}`}
						aria-selected={index === 5 ? 'true' : 'false'}
					></button>
				))}
			</div>
		</div>
	</section>

	<footer class="home-footer" aria-labelledby="footer-contact-heading">
		<div class="home-container home-footer__grid">
			<div class="home-footer__brand">
				<img src="/assets/home/footer-logo.png" alt={content.title} width="200" height="94" loading="lazy" />
				<div class="home-footer__phones">
					{content.footer.phones.map((phone) => <a href={`tel:${phone}`}>{phone}</a>)}
				</div>
				<div class="home-footer__addresses">
					{content.footer.addresses.map((address) => <p>{address}</p>)}
				</div>
			</div>

			<div class="home-footer__news">
				<h2>{content.footer.newsTitle}</h2>
				<ul>
					{content.footer.recentNews.map((item) => <li>{item}</li>)}
				</ul>
			</div>

			<form class="home-contact-form" data-contact-form aria-labelledby="footer-contact-heading">
				<h2 id="footer-contact-heading">{content.footer.formTitle}</h2>
				<label>
					<span>{content.footer.form.name}</span>
					<input name="name" autocomplete="name" required />
				</label>
				<label>
					<span>{content.footer.form.email}</span>
					<input name="email" type="email" autocomplete="email" required />
				</label>
				<label>
					<span>{content.footer.form.phone}</span>
					<input name="phone" type="tel" autocomplete="tel" />
				</label>
				<label>
					<span>{content.footer.form.service}</span>
					<select name="service" required>
						<option value="">{content.footer.form.service}</option>
						{content.services.items.map((service) => <option value={service.title}>{service.title}</option>)}
					</select>
				</label>
				<label class="home-contact-form__message">
					<span>{content.footer.form.message}</span>
					<textarea name="message" rows="5"></textarea>
				</label>
				<button class="home-button home-button--light" type="submit">{content.footer.form.submit}</button>
				<p class="home-contact-form__notice" data-form-notice hidden>{content.footer.form.previewNotice}</p>
			</form>
		</div>
		<p class="home-footer__copyright">{content.footer.copyright}</p>
	</footer>
</div>

<script>
	const homePage = document.querySelector('[data-home-page]');

	if (homePage instanceof HTMLElement) {
		const slides = Array.from(homePage.querySelectorAll('[data-hero-slide]'));
		const dots = Array.from(homePage.querySelectorAll('[data-hero-dot]'));
		const previousButton = homePage.querySelector('[data-hero-prev]');
		const nextButton = homePage.querySelector('[data-hero-next]');
		let activeSlide = 0;

		const showSlide = (index) => {
			if (!slides.length) return;
			activeSlide = (index + slides.length) % slides.length;
			slides.forEach((slide, slideIndex) => {
				const isActive = slideIndex === activeSlide;
				slide.classList.toggle('is-active', isActive);
				slide.setAttribute('aria-hidden', String(!isActive));
			});
			dots.forEach((dot, dotIndex) => {
				const isActive = dotIndex === activeSlide;
				dot.classList.toggle('is-active', isActive);
				dot.setAttribute('aria-selected', String(isActive));
			});
		};

		if (previousButton instanceof HTMLButtonElement) {
			previousButton.addEventListener('click', () => showSlide(activeSlide - 1));
		}

		if (nextButton instanceof HTMLButtonElement) {
			nextButton.addEventListener('click', () => showSlide(activeSlide + 1));
		}

		dots.forEach((dot) => {
			if (dot instanceof HTMLButtonElement) {
				dot.addEventListener('click', () => {
					const index = Number(dot.dataset.heroDot ?? 0);
					showSlide(index);
				});
			}
		});

		const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

		const setupCarousel = (name) => {
			const carousel = homePage.querySelector(`[data-carousel="${name}"]`);
			if (!(carousel instanceof HTMLElement)) return;

			const carouselSlides = Array.from(homePage.querySelectorAll(`[data-carousel-slide="${name}"]`));
			const carouselDots = Array.from(homePage.querySelectorAll(`[data-carousel-dot="${name}"]`));
			const carouselPrevious = homePage.querySelector(`[data-carousel-prev="${name}"]`);
			const carouselNext = homePage.querySelector(`[data-carousel-next="${name}"]`);
			if (!carouselSlides.length) return;

			let activeIndex = Number(carousel.dataset.carouselStart ?? 0);
			let autoplayTimer;

			const normalizeIndex = (index) => (index + carouselSlides.length) % carouselSlides.length;

			const showCarouselSlide = (index) => {
				activeIndex = normalizeIndex(index);
				const previousIndex = normalizeIndex(activeIndex - 1);
				const nextIndex = normalizeIndex(activeIndex + 1);

				carouselSlides.forEach((slide, slideIndex) => {
					const isActive = slideIndex === activeIndex;
					const isPrevious = slideIndex === previousIndex;
					const isNext = slideIndex === nextIndex;
					slide.classList.toggle('is-active', isActive);
					slide.classList.toggle('is-prev', isPrevious);
					slide.classList.toggle('is-next', isNext);
					slide.setAttribute('aria-hidden', String(!(isActive || isPrevious || isNext)));
					slide.querySelectorAll('a, button').forEach((item) => {
						if (!(item instanceof HTMLElement)) return;
						if (isActive) item.removeAttribute('tabindex');
						else item.setAttribute('tabindex', '-1');
					});
				});

				carouselDots.forEach((dot) => {
					const dotIndex = Number(dot instanceof HTMLElement ? dot.dataset.carouselIndex ?? 0 : 0);
					const isActive = dotIndex === activeIndex;
					dot.classList.toggle('is-active', isActive);
					dot.setAttribute('aria-selected', String(isActive));
				});
			};

			const stopAutoplay = () => {
				if (autoplayTimer) window.clearInterval(autoplayTimer);
				autoplayTimer = undefined;
			};

			const startAutoplay = () => {
				const delay = Number(carousel.dataset.carouselAutoplay ?? 0);
				if (!delay || prefersReducedMotion.matches) return;
				stopAutoplay();
				autoplayTimer = window.setInterval(() => showCarouselSlide(activeIndex + 1), delay);
			};

			if (carouselPrevious instanceof HTMLButtonElement) {
				carouselPrevious.addEventListener('click', () => showCarouselSlide(activeIndex - 1));
			}

			if (carouselNext instanceof HTMLButtonElement) {
				carouselNext.addEventListener('click', () => showCarouselSlide(activeIndex + 1));
			}

			carouselDots.forEach((dot) => {
				if (dot instanceof HTMLButtonElement) {
					dot.addEventListener('click', () => showCarouselSlide(Number(dot.dataset.carouselIndex ?? 0)));
				}
			});

			const keyboardTarget = carousel.matches('[tabindex]') ? carousel : carousel.querySelector('[tabindex]');
			if (keyboardTarget instanceof HTMLElement) keyboardTarget.addEventListener('keydown', (event) => {
				if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
				event.preventDefault();
				const direction = document.documentElement.dir === 'rtl' ? -1 : 1;
				showCarouselSlide(activeIndex + (event.key === 'ArrowRight' ? direction : -direction));
			});

			carousel.addEventListener('mouseenter', stopAutoplay);
			carousel.addEventListener('mouseleave', startAutoplay);
			carousel.addEventListener('focusin', stopAutoplay);
			carousel.addEventListener('focusout', startAutoplay);
			prefersReducedMotion.addEventListener('change', () => {
				stopAutoplay();
				startAutoplay();
			});

			showCarouselSlide(activeIndex);
			startAutoplay();
		};

		setupCarousel('projects');
		setupCarousel('partners');

		const counters = Array.from(homePage.querySelectorAll('[data-counter]'));
		const animateCounters = () => {
			counters.forEach((counter) => {
				if (!(counter instanceof HTMLElement) || counter.dataset.counted === 'true') return;
				counter.dataset.counted = 'true';
				const target = Number(counter.dataset.target ?? 0);
				counter.textContent = '0';
				const duration = 900;
				const startTime = performance.now();
				const update = (time) => {
					const progress = Math.min((time - startTime) / duration, 1);
					counter.textContent = String(Math.round(target * progress));
					if (progress < 1) requestAnimationFrame(update);
				};
				requestAnimationFrame(update);
			});
		};

		if ('IntersectionObserver' in window && counters.length) {
			const stats = homePage.querySelector('.home-stats');
			if (stats instanceof HTMLElement) {
				const observer = new IntersectionObserver((entries) => {
					if (entries.some((entry) => entry.isIntersecting)) {
						animateCounters();
						observer.disconnect();
					}
				}, { threshold: 0.25 });
				observer.observe(stats);
			} else {
				animateCounters();
			}
		} else {
			animateCounters();
		}

		const form = homePage.querySelector('[data-contact-form]');
		const notice = homePage.querySelector('[data-form-notice]');
		if (form instanceof HTMLFormElement && notice instanceof HTMLElement) {
			form.addEventListener('submit', (event) => {
				event.preventDefault();
				notice.hidden = false;
			});
		}
	}
</script>

<style>
	.home-page {
		margin-block: calc(0px - var(--space-xl));
		margin-inline: calc(0px - var(--page-gutter));
		background: var(--color-surface);
		color: var(--color-text);
	}

	.home-container {
		inline-size: min(1300px, calc(100% - var(--page-gutter) - var(--page-gutter)));
		margin-inline: auto;
	}

	.home-hero {
		position: relative;
		isolation: isolate;
		min-block-size: 100vh;
		overflow: hidden;
		background: var(--color-heading);
	}

	.home-hero__slides,
	.home-hero__slide {
		position: absolute;
		inset: 0;
	}

	.home-hero__slide {
		display: grid;
		align-items: center;
		opacity: 0;
		visibility: hidden;
		transition: opacity 480ms ease, visibility 480ms ease;
	}

	.home-hero__slide.is-active {
		opacity: 1;
		visibility: visible;
	}

	.home-hero__image {
		position: absolute;
		inset: 0;
		z-index: -2;
		inline-size: 100%;
		block-size: 100%;
		object-fit: cover;
	}

	.home-hero__overlay {
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(90deg, rgba(0, 0, 0, 0.48), rgba(0, 0, 0, 0.3) 52%, rgba(0, 0, 0, 0.18));
	}

	:global([dir='rtl']) .home-hero__overlay {
		background: linear-gradient(270deg, rgba(0, 0, 0, 0.48), rgba(0, 0, 0, 0.3) 52%, rgba(0, 0, 0, 0.18));
	}

	.home-hero__content {
		inline-size: min(1360px, calc(100% - var(--page-gutter) - var(--page-gutter)));
		margin-inline: auto;
		padding-block: 120px 96px;
		padding-inline: 30px;
		color: var(--color-surface);
	}

	.home-hero h1 {
		max-inline-size: 680px;
		margin: 0 0 22px;
		color: var(--color-surface);
		font-size: clamp(48px, 5vw, 68px);
		font-weight: var(--font-weight-bold);
		letter-spacing: -0.035em;
		line-height: 1.03;
		text-transform: uppercase;
	}

	:global([dir='rtl']) .home-hero h1 {
		letter-spacing: 0;
		line-height: 1.05;
	}

	.home-hero p {
		max-inline-size: 560px;
		margin: 0 0 34px;
		color: rgba(255, 255, 255, 0.9);
		font-size: 16px;
		line-height: 1.65;
	}

	.home-hero__controls {
		position: absolute;
		z-index: 3;
		inset-inline: 32px;
		inset-block-end: 34px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		pointer-events: none;
	}

	.home-hero__dots {
		display: flex;
		gap: 10px;
		pointer-events: auto;
	}

	.home-hero__dot,
	.home-hero__arrow {
		border: 1px solid rgba(255, 255, 255, 0.68);
		background: rgba(255, 255, 255, 0.12);
		color: var(--color-surface);
		cursor: pointer;
	}

	.home-hero__dot {
		inline-size: 12px;
		block-size: 12px;
		padding: 0;
		border-radius: 999px;
	}

	.home-hero__dot.is-active {
		background: var(--color-surface);
	}

	.home-hero__arrow {
		inline-size: 44px;
		block-size: 44px;
		border-radius: 50%;
		font-size: 28px;
		line-height: 1;
		pointer-events: auto;
	}

	.home-button,
	.home-text-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-heading);
		font-weight: var(--font-weight-semibold);
		text-decoration: none;
	}

	.home-button {
		min-block-size: 46px;
		padding: 13px 26px;
		background: var(--color-brand-primary);
		color: var(--color-surface);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.home-button--light {
		background: var(--color-surface);
		color: var(--color-heading);
	}

	.home-section {
