---
import type { Locale } from '../data/locales';

interface Props {
	locale: Locale;
}

interface HeroSlide {
	kicker: string;
	title: string;
	location: string;
	cta: string;
	image: string;
	alt: string;
	videoDesktop?: string;
	videoMobile?: string;
}

const { locale } = Astro.props;
const isArabic = locale === 'ar';

const content = {
	en: {
		brand: 'AL MASA',
		menu: 'Menu',
		close: 'Close',
		nav: [
			{ label: 'Selected Works', href: '#hero' },
			{ label: 'Capabilities', href: '#hero' },
			{ label: 'About', href: '#hero' },
			{ label: 'Inquiry', href: '#hero' },
		],
		slides: [
			{
				kicker: 'Current Project',
				title: 'Al Alphy',
				location: 'Real AL MASA project media',
				cta: 'View Project',
				image: '/assets/owner-confirmed/hero/al-alphy-hero-poster.jpg',
				alt: 'Real AL MASA Al Alphy project video still',
				videoDesktop: '/assets/owner-confirmed/hero/al-alphy-hero-desktop.mp4',
				videoMobile: '/assets/owner-confirmed/hero/al-alphy-hero-mobile.mp4',
			},
			{
				kicker: 'Landmark Contracting',
				title: 'Architectural Structural Finishing',
				location: 'Executive Developments, Egypt',
				cta: 'View Project',
				image: '/assets/owner-confirmed/hero/hero-02-poster.jpg',
				alt: 'Axial architectural view of a major AL MASA project',
				videoDesktop: '/assets/owner-confirmed/hero/hero-02.mp4',
			},
			{
				kicker: 'Innovation & Academic Hubs',
				title: 'CREATIVA Innovation Hub',
				location: 'Tanta University',
				cta: 'View Project',
				image: '/assets/owner-confirmed/hero/hero-03-poster.jpg',
				alt: 'CREATIVA Innovation Hub daylight exterior at Tanta University',
				videoDesktop: '/assets/owner-confirmed/hero/hero-03.mp4',
			},
			{
				kicker: 'Institutional Headquarters',
				title: 'Corporate & Civic Facilities',
				location: 'New Administrative Capital',
				cta: 'View Project',
				image: '/assets/owner-confirmed/hero/hero-04-poster.jpg',
				alt: 'Aerial view of an AL MASA institutional project',
				videoDesktop: '/assets/owner-confirmed/hero/hero-04.mp4',
			},
		] satisfies HeroSlide[],
	},
	ar: {
		brand: 'الماسة',
		menu: 'القائمة',
		close: 'إغلاق',
		nav: [
			{ label: 'الأعمال المختارة', href: '#hero' },
			{ label: 'القدرات', href: '#hero' },
			{ label: 'عن الماسة', href: '#hero' },
			{ label: 'استفسار', href: '#hero' },
		],
		slides: [
			{
				kicker: 'مشروع حالي',
				title: 'الألفي',
				location: 'فيديو حقيقي من أعمال الماسة',
				cta: 'عرض المشروع',
				image: '/assets/owner-confirmed/hero/al-alphy-hero-poster.jpg',
				alt: 'لقطة فيديو حقيقية من مشروع الألفي للماسة',
				videoDesktop: '/assets/owner-confirmed/hero/al-alphy-hero-desktop.mp4',
				videoMobile: '/assets/owner-confirmed/hero/al-alphy-hero-mobile.mp4',
			},
			{
				kicker: 'تنفيذ معماري',
				title: 'أعمال تشطيبات إنشائية ومعمارية',
				location: 'مصر',
				cta: 'عرض المشروع',
				image: '/assets/owner-confirmed/hero/hero-02-poster.jpg',
				alt: 'منظور معماري محوري لمشروع من أعمال الماسة',
				videoDesktop: '/assets/owner-confirmed/hero/hero-02.mp4',
			},
			{
				kicker: 'مراكز ابتكار وتعليم',
				title: 'مراكز إبداع مصر الرقمية',
				location: 'جامعة طنطا',
				cta: 'عرض المشروع',
				image: '/assets/owner-confirmed/hero/hero-03-poster.jpg',
				alt: 'واجهة مركز إبداع مصر الرقمية في جامعة طنطا',
				videoDesktop: '/assets/owner-confirmed/hero/hero-03.mp4',
			},
			{
				kicker: 'منشآت مؤسسية',
				title: 'منشآت مؤسسية ومدنية',
				location: 'العاصمة الإدارية الجديدة',
				cta: 'عرض المشروع',
				image: '/assets/owner-confirmed/hero/hero-04-poster.jpg',
				alt: 'صورة جوية لمشروع مؤسسي من أعمال الماسة',
				videoDesktop: '/assets/owner-confirmed/hero/hero-04.mp4',
			},
		] satisfies HeroSlide[],
	},
}[locale];

const completedMega = {
	en: {
		title: 'Completed Projects',
		projects: [
			{
				title: 'مزرعة الخيول',
				location: 'New Administrative Capital',
				image: '/assets/owner-confirmed/completed-mega/project-35-horse-farm.jpeg',
				alt: 'Selected completed AL MASA mega project image for project 35',
			},
			{
				title: 'المقطم',
				location: 'Mokattam, Cairo',
				image: '/assets/owner-confirmed/completed-mega/project-05-mokattam.jpeg',
				alt: 'Selected completed AL MASA mega project image for project 5',
			},
		],
	},
	ar: {
		title: 'المشاريع المنتهية',
		projects: [
			{
				title: 'مزرعة الخيول',
				location: 'العاصمة الإدارية',
				image: '/assets/owner-confirmed/completed-mega/project-35-horse-farm.jpeg',
				alt: 'صورة مختارة من مشروع مزرعة الخيول رقم 35 للماسة',
			},
			{
				title: 'المقطم',
				location: 'القاهرة - مدينة المقطم',
				image: '/assets/owner-confirmed/completed-mega/project-05-mokattam.jpeg',
				alt: 'صورة مختارة من مشروع المقطم رقم 5 للماسة',
			},
		],
	},
}[locale];
---

<div class="owner-home" data-owner-home data-locale={locale}>
	<header class="owner-nav" aria-label={isArabic ? 'التنقل الرئيسي' : 'Primary navigation'}>
		<div class="owner-container owner-nav__inner">
			<a class="owner-brand" href={isArabic ? '/ar/' : '/en/'} aria-label={content.brand}>
				<img src="/assets/owner-confirmed/brand/logo-primary.png" alt={content.brand} width="85" height="40" />
				<span>{content.brand}</span>
			</a>

			<nav class="owner-nav__links" aria-label={isArabic ? 'روابط الصفحة الرئيسية' : 'Homepage links'}>
				{content.nav.map((item) => <a href={item.href}>{item.label}</a>)}
			</nav>

			<button class="owner-nav__menu" type="button" aria-expanded="false" aria-controls="owner-mobile-drawer" data-owner-menu-toggle>
				<span class="owner-nav__menu-icon" aria-hidden="true"><span></span><span></span></span>
				<span>{content.menu}</span>
			</button>
		</div>
	</header>

	<div id="owner-mobile-drawer" class="owner-drawer" aria-hidden="true" data-owner-drawer>
		<div class="owner-drawer__inner">
			<div class="owner-drawer__header">
				<span>{content.brand}</span>
				<button type="button" data-owner-drawer-close aria-label={content.close}>×</button>
			</div>
			<nav aria-label={isArabic ? 'قائمة الهاتف' : 'Mobile navigation'}>
				{content.nav.map((item, index) => (
					<a class="owner-drawer__link" href={item.href}>
						<span>{String(index + 1).padStart(2, '0')}</span>
						{item.label}
					</a>
				))}
			</nav>
		</div>
	</div>

	<section class="owner-hero" id="hero" aria-label={isArabic ? 'عرض المشاريع الرئيسية' : 'Featured project showcase'} data-owner-hero>
		<div class="owner-container">
			<div class="owner-hero__frame">
				<div class="owner-hero__slides" aria-live="polite">
					{content.slides.map((slide, index) => (
						<article
							class:list={["owner-hero__slide", { 'is-active': index === 0 }]}
							data-owner-hero-slide
							aria-hidden={index === 0 ? 'false' : 'true'}
						>
							{slide.videoDesktop ? (
								<video
									class="owner-hero__video"
									poster={slide.image}
									muted
									playsinline
									preload="metadata"
									aria-label={slide.alt}
									data-owner-hero-video
									data-owner-video-desktop={slide.videoDesktop}
									data-owner-video-mobile={slide.videoMobile ?? slide.videoDesktop}
								>
									<source src={slide.videoDesktop} media="(min-width: 861px)" type="video/mp4" />
									{slide.videoMobile && <source src={slide.videoMobile} media="(max-width: 860px)" type="video/mp4" />}
									<img src={slide.image} alt={slide.alt} width="1440" height="760" loading={index === 0 ? 'eager' : 'lazy'} decoding={index === 0 ? 'sync' : 'async'} />
								</video>
							) : (
								<img src={slide.image} alt={slide.alt} width="1440" height="760" loading={index === 0 ? 'eager' : 'lazy'} decoding={index === 0 ? 'sync' : 'async'} />
							)}
							<div class="owner-hero__caption owner-hero__caption--desktop">
								<div>
									<p class="owner-hero__kicker">{slide.kicker}</p>
									{index === 0 ? <h1>{slide.title}</h1> : <h2>{slide.title}</h2>}
									<p class="owner-hero__location">{slide.location}</p>
								</div>
								<a class="owner-hero__action" href="#hero">{slide.cta} <span aria-hidden="true">→</span></a>
							</div>
						</article>
					))}
				</div>

				<div class="owner-hero__indicators" role="tablist" aria-label={isArabic ? 'اختيار الشريحة' : 'Choose hero slide'}>
					{content.slides.map((slide, index) => (
						<button
							class:list={["owner-hero__indicator", { 'is-active': index === 0 }]}
							type="button"
							data-owner-hero-dot={index}
							aria-label={`${isArabic ? 'الشريحة' : 'Slide'} ${index + 1}: ${slide.title}`}
							aria-selected={index === 0 ? 'true' : 'false'}
						>
							<span>{String(index + 1).padStart(2, '0')}</span>
							<span class="owner-hero__bar"><span></span></span>
						</button>
					))}
				</div>
			</div>

			<div class="owner-hero__caption owner-hero__caption--mobile" data-owner-mobile-caption>
				<p class="owner-hero__kicker">{content.slides[0].kicker}</p>
				<h1>{content.slides[0].title}</h1>
				<p class="owner-hero__location">{content.slides[0].location}</p>
				<a class="owner-hero__action" href="#hero">{content.slides[0].cta} <span aria-hidden="true">→</span></a>
				<div class="owner-hero__mobile-dots" aria-label={isArabic ? 'اختيار الشريحة' : 'Choose hero slide'}>
					{content.slides.map((slide, index) => (
						<button class:list={["owner-hero__mobile-dot", { 'is-active': index === 0 }]} type="button" data-owner-hero-mobile-dot={index} aria-label={`${isArabic ? 'الشريحة' : 'Slide'} ${index + 1}: ${slide.title}`}></button>
					))}
				</div>
			</div>
		</div>
	</section>

	<section class="owner-completed-mega" id="completed-mega" aria-labelledby="completed-mega-title">
		<div class="owner-container">
			<div class="owner-section-header">
				<h2 id="completed-mega-title">{completedMega.title}</h2>
			</div>

			<div class="owner-mega-grid" aria-label={isArabic ? 'مشاريع كبرى منتهية مختارة' : 'Selected completed mega projects'}>
				{completedMega.projects.map((project, index) => (
					<article class:list={["owner-mega-card", { 'owner-mega-card--wide': index === 0 }]}>
						<div class="owner-mega-card__media">
							<img src={project.image} alt={project.alt} width={index === 0 ? '1040' : '1280'} height={index === 0 ? '780' : '720'} loading="lazy" decoding="async" />
							<div class="owner-mega-card__caption">
								<h3>{project.title}</h3>
								<span>{project.location}</span>
							</div>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>
</div>

<script define:vars={{ slides: content.slides }}>
	const ownerHome = document.querySelector('[data-owner-home]');

	if (ownerHome instanceof HTMLElement) {
		const drawer = ownerHome.querySelector('[data-owner-drawer]');
		const toggle = ownerHome.querySelector('[data-owner-menu-toggle]');
		const close = ownerHome.querySelector('[data-owner-drawer-close]');
		const drawerLinks = Array.from(ownerHome.querySelectorAll('.owner-drawer__link'));

		const setDrawerOpen = (open) => {
			if (!(drawer instanceof HTMLElement) || !(toggle instanceof HTMLButtonElement)) return;
			drawer.classList.toggle('is-open', open);
			drawer.setAttribute('aria-hidden', String(!open));
			toggle.setAttribute('aria-expanded', String(open));
			document.body.style.overflow = open ? 'hidden' : '';
		};

		if (toggle instanceof HTMLButtonElement) toggle.addEventListener('click', () => setDrawerOpen(!drawer?.classList.contains('is-open')));
		if (close instanceof HTMLButtonElement) close.addEventListener('click', () => setDrawerOpen(false));
		drawerLinks.forEach((link) => link.addEventListener('click', () => setDrawerOpen(false)));
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') setDrawerOpen(false);
		});

		const hero = ownerHome.querySelector('[data-owner-hero]');
		const slideEls = Array.from(ownerHome.querySelectorAll('[data-owner-hero-slide]'));
		const desktopDots = Array.from(ownerHome.querySelectorAll('[data-owner-hero-dot]'));
		const mobileDots = Array.from(ownerHome.querySelectorAll('[data-owner-hero-mobile-dot]'));
		const mobileCaption = ownerHome.querySelector('[data-owner-mobile-caption]');
		const videos = Array.from(ownerHome.querySelectorAll('[data-owner-hero-video]'));
		const mobileVideoQuery = window.matchMedia('(max-width: 860px)');
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		let activeIndex = 0;
		let timer;

		const configureVideoSource = (video) => {
			if (!(video instanceof HTMLVideoElement)) return;
			const preferred = mobileVideoQuery.matches ? video.dataset.ownerVideoMobile : video.dataset.ownerVideoDesktop;
			if (!preferred) return;
			const preferredUrl = new URL(preferred, window.location.href).href;
			if (video.currentSrc === preferredUrl || video.src === preferredUrl) return;
			video.pause();
			video.src = preferred;
			video.load();
		};

		videos.forEach((video) => {
			if (!(video instanceof HTMLVideoElement)) return;
			video.muted = true;
			video.defaultMuted = true;
			video.playsInline = true;
			video.setAttribute('muted', '');
			video.setAttribute('playsinline', '');
			configureVideoSource(video);
		});

		mobileVideoQuery.addEventListener('change', () => {
			videos.forEach((video) => configureVideoSource(video));
			showSlide(activeIndex);
			startAuto();
		});

		const updateMobileCaption = (index) => {
			if (!(mobileCaption instanceof HTMLElement)) return;
			const slide = slides[index];
			const kicker = mobileCaption.querySelector('.owner-hero__kicker');
			const title = mobileCaption.querySelector('h1');
			const location = mobileCaption.querySelector('.owner-hero__location');
			const action = mobileCaption.querySelector('.owner-hero__action');
			if (kicker) kicker.textContent = slide.kicker;
			if (title) title.textContent = slide.title;
			if (location) location.textContent = slide.location;
			if (action) action.childNodes[0].textContent = `${slide.cta} `;
		};

		const showSlide = (index) => {
			if (!slideEls.length) return;
			activeIndex = (index + slideEls.length) % slideEls.length;
			slideEls.forEach((slide, slideIndex) => {
				const active = slideIndex === activeIndex;
				slide.classList.toggle('is-active', active);
				slide.setAttribute('aria-hidden', String(!active));
				const video = slide.querySelector('[data-owner-hero-video]');
				if (video instanceof HTMLVideoElement) {
					configureVideoSource(video);
					if (active && !reduceMotion.matches) {
						try {
							video.currentTime = 0;
						} catch (error) {}
						video.play().catch(() => {
							// Keep the poster visible if a browser blocks autoplay.
						});
					} else {
						video.pause();
						try {
							video.currentTime = 0;
						} catch (error) {}
					}
				}
			});
			[...desktopDots, ...mobileDots].forEach((dot) => {
				if (!(dot instanceof HTMLElement)) return;
				const dotIndex = Number(dot.dataset.ownerHeroDot ?? dot.dataset.ownerHeroMobileDot ?? 0);
				const active = dotIndex === activeIndex;
				dot.classList.toggle('is-active', active);
				dot.setAttribute('aria-selected', String(active));
			});
			updateMobileCaption(activeIndex);
		};

		const stopAuto = () => {
			if (timer) window.clearTimeout(timer);
			timer = undefined;
		};

		const advanceSlide = () => {
			showSlide(activeIndex + 1);
			startAuto();
		};

		const startAuto = () => {
			stopAuto();
			if (reduceMotion.matches) {
				videos.forEach((video) => {
					if (video instanceof HTMLVideoElement) video.pause();
				});
				return;
			}
			const activeVideo = slideEls[activeIndex]?.querySelector('[data-owner-hero-video]');
			if (activeVideo instanceof HTMLVideoElement) {
				activeVideo.play().catch(() => {
					// Poster fallback remains visible if autoplay is unavailable.
				});
				return;
			}
			timer = window.setTimeout(advanceSlide, 6200);
		};

		videos.forEach((video) => {
			if (!(video instanceof HTMLVideoElement)) return;
			video.addEventListener('ended', () => {
				const owningSlide = slideEls.findIndex((slide) => slide.contains(video));
				if (owningSlide === activeIndex && !reduceMotion.matches) advanceSlide();
			});
		});

		[...desktopDots, ...mobileDots].forEach((dot) => {
			if (!(dot instanceof HTMLButtonElement)) return;
			dot.addEventListener('click', () => {
				showSlide(Number(dot.dataset.ownerHeroDot ?? dot.dataset.ownerHeroMobileDot ?? 0));
				startAuto();
			});
		});

		hero?.addEventListener('mouseenter', stopAuto);
		hero?.addEventListener('mouseleave', startAuto);
		hero?.addEventListener('focusin', stopAuto);
		hero?.addEventListener('focusout', startAuto);
		reduceMotion.addEventListener('change', startAuto);
		showSlide(0);
		startAuto();
	}
</script>

<style>
	.owner-home {
		--bg-main: #ffffff;
		--surface-soft: #e8f6fe;
		--surface-soft-border: rgba(8, 145, 178, 0.16);
		--serene-accent: #0891b2;
		--serene-accent-hover: #0e7490;
		--almasa-blue: #003a6b;
		--almasa-blue-hover: #002b50;
		--text-primary: #0f172a;
		--text-secondary: #475569;
		--text-muted: #64748b;
		--border-subtle: #e2e8f0;
		--font-display: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
		--font-ui: 'Inter', 'Segoe UI', Arial, sans-serif;
		min-block-size: 100vh;
		background: var(--bg-main);
		color: var(--text-primary);
		font-family: var(--font-ui);
		margin: 0;
		padding: 0;
		overflow-x: clip;
	}

	.owner-home *,
	.owner-home *::before,
	.owner-home *::after {
		box-sizing: border-box;
	}

	.owner-container {
		inline-size: 100%;
		max-inline-size: 1800px;
		margin-inline: auto;
		padding-inline: 28px;
		box-sizing: border-box;
	}

	.owner-nav {
		position: sticky;
		inset-block-start: 0;
		z-index: 100;
		block-size: 54px;
		display: flex;
		align-items: center;
		background: rgba(255, 255, 255, 0.96);
		border-block-end: 1px solid rgba(8, 145, 178, 0.12);
		backdrop-filter: blur(14px);
	}

	.owner-nav__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
	}

	.owner-brand {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		color: var(--almasa-blue);
		text-decoration: none;
	}

	.owner-brand img {
		inline-size: auto;
		block-size: 26px;
		object-fit: contain;
	}

	.owner-brand span,
	.owner-drawer__header span {
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 700;
		letter-spacing: 1.5px;
		text-transform: uppercase;
		color: var(--almasa-blue);
	}

	.owner-nav__links {
		display: flex;
		align-items: center;
		gap: 28px;
	}

	.owner-nav__links a {
		font-size: 0.82rem;
		font-weight: 500;
		color: var(--text-secondary);
		text-decoration: none;
		white-space: nowrap;
		transition: color 0.2s ease;
	}

	.owner-nav__links a:hover,
	.owner-nav__links a:last-child {
		color: var(--serene-accent);
	}

	.owner-nav__menu {
		display: none;
	}

	.owner-hero {
		padding-block-start: 16px;
	}

	.owner-hero__frame {
		position: relative;
		block-size: 76vh;
		min-block-size: 500px;
		max-block-size: 660px;
		border: 1px solid var(--surface-soft-border);
		border-radius: 8px;
		background: #001224;
		overflow: hidden;
	}

	.owner-hero__slides,
	.owner-hero__slide,
	.owner-hero__slide img,
	.owner-hero__video {
		position: absolute;
		inset: 0;
		inline-size: 100%;
		block-size: 100%;
	}

	.owner-hero__slide {
		opacity: 0;
		visibility: hidden;
		transition: opacity 850ms cubic-bezier(0.16, 1, 0.3, 1), visibility 850ms;
	}

	.owner-hero__slide.is-active {
		opacity: 1;
		visibility: visible;
	}

	.owner-hero__slide img,
	.owner-hero__video {
		object-fit: cover;
		object-position: center 46%;
	}

	.owner-hero__caption--desktop {
		position: absolute;
		inset-inline: 0;
		inset-block-end: 0;
		z-index: 3;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 28px;
		padding: 3.5rem 2.25rem 2rem;
		color: #fff;
		background: linear-gradient(180deg, rgba(0, 20, 42, 0) 0%, rgba(0, 20, 42, 0.45) 40%, rgba(0, 24, 52, 0.85) 100%);
	}

	.owner-hero__caption--desktop > div {
		max-inline-size: 65%;
