---
import type { Locale } from '../data/locales';
import ProjectsShowcase from './ProjectsShowcase.astro';
import EducationalChannel from './EducationalChannel.astro';
import SiteFooter from './SiteFooter.astro';

interface Props {
	locale: Locale;
}

interface HeroSlide {
	title: string;
	cta: string;
	href?: string;
	image: string;
	alt: string;
	videoDesktop?: string;
	videoMobile?: string;
}

const locale = Astro.props.locale;
const isArabic = locale === 'ar';

const content = {
	en: {
		brand: 'AL MASA',
		menu: 'Menu',
		close: 'Close',
		nav: [
			{ label: 'Selected Works', href: '/en/projects/' },
			{ label: 'Approach', href: '/en/approach/' },
			{ label: 'About', href: '/en/about/' },
			{ label: 'Contact', href: '/en/contact/' },
		],
		slides: [
			{
				title: 'Al Alphy',
				cta: 'View Project',
				href: '/en/projects/al-alphy/',
				image: '/assets/owner-confirmed/hero/hero-m-alphy-poster.jpg',
				alt: 'Real AL MASA Al Alphy project video still',
				videoDesktop: '/assets/owner-confirmed/hero/hero-m-alphy.mp4',
				videoMobile: '/assets/owner-confirmed/hero/hero-m-alphy-720.mp4',
			},
			{
				title: 'خيرات الرحمن',
				cta: 'View Project',
				href: '/en/projects/khairat-rahman/',
				image: '/assets/owner-confirmed/hero/hero-m-khairat-poster.jpg',
				alt: 'Real AL MASA project footage: خيرات الرحمن',
				videoDesktop: '/assets/owner-confirmed/hero/hero-m-khairat.mp4',
				videoMobile: '/assets/owner-confirmed/hero/hero-m-khairat-720.mp4',
			},
			{
				title: 'مول الروبيكي',
				cta: 'View Project',
				href: '/en/projects/roubeky-mall/',
				image: '/assets/owner-confirmed/hero/hero-m-roubeky-poster.jpg',
				alt: 'Real AL MASA project footage: مول الروبيكي',
				videoDesktop: '/assets/owner-confirmed/hero/hero-m-roubeky.mp4',
				videoMobile: '/assets/owner-confirmed/hero/hero-m-roubeky-720.mp4',
			},
			{
				title: 'مزرعة الخيول',
				cta: 'View Project',
				href: '/en/projects/horse-farm/',
				image: '/assets/owner-confirmed/hero/hero-m-horse-poster.jpg',
				alt: 'Real AL MASA project footage: مزرعة الخيول',
				videoDesktop: '/assets/owner-confirmed/hero/hero-m-horse.mp4',
				videoMobile: '/assets/owner-confirmed/hero/hero-m-horse-720.mp4',
			},
			{
				title: 'المقطم',
				cta: 'View Project',
				href: '/en/projects/mokattam/',
				image: '/assets/owner-confirmed/hero/hero-m-mokattam-poster.jpg',
				alt: 'Real AL MASA project footage: المقطم',
				videoDesktop: '/assets/owner-confirmed/hero/hero-m-mokattam-clean2.mp4',
				videoMobile: '/assets/owner-confirmed/hero/hero-m-mokattam-clean2.mp4',
			},
		] satisfies HeroSlide[],
	},
	ar: {
		brand: 'الماسة',
		menu: 'القائمة',
		close: 'إغلاق',
		nav: [
			{ label: 'الأعمال المختارة', href: '#hero' },
			{ label: 'القدرات', href: '#hero' },
			{ label: 'عن الماسة', href: '#hero' },
			{ label: 'استفسار', href: '#hero' },
		],
		slides: [
			{
				title: 'الألفي',
				cta: 'عرض المشروع',
				image: '/assets/owner-confirmed/hero/hero-m-alphy-poster.jpg',
				alt: 'لقطة فيديو حقيقية من مشروع الألفي للماسة',
				videoDesktop: '/assets/owner-confirmed/hero/hero-m-alphy.mp4',
				videoMobile: '/assets/owner-confirmed/hero/hero-m-alphy-720.mp4',
			},
			{
				title: 'خيرات الرحمن',
				cta: 'عرض المشروع',
				image: '/assets/owner-confirmed/hero/hero-m-khairat-poster.jpg',
				alt: 'فيديو حقيقي من مشروع خيرات الرحمن',
				videoDesktop: '/assets/owner-confirmed/hero/hero-m-khairat.mp4',
				videoMobile: '/assets/owner-confirmed/hero/hero-m-khairat-720.mp4',
			},
			{
				title: 'مول الروبيكي',
				cta: 'عرض المشروع',
				image: '/assets/owner-confirmed/hero/hero-m-roubeky-poster.jpg',
				alt: 'فيديو حقيقي من مشروع مول الروبيكي',
				videoDesktop: '/assets/owner-confirmed/hero/hero-m-roubeky.mp4',
				videoMobile: '/assets/owner-confirmed/hero/hero-m-roubeky-720.mp4',
			},
			{
				title: 'مزرعة الخيول',
				cta: 'عرض المشروع',
				image: '/assets/owner-confirmed/hero/hero-m-horse-poster.jpg',
				alt: 'فيديو حقيقي من مشروع مزرعة الخيول',
				videoDesktop: '/assets/owner-confirmed/hero/hero-m-horse.mp4',
				videoMobile: '/assets/owner-confirmed/hero/hero-m-horse-720.mp4',
			},
			{
				title: 'المقطم',
				cta: 'عرض المشروع',
				image: '/assets/owner-confirmed/hero/hero-m-mokattam-poster.jpg',
				alt: 'فيديو حقيقي من مشروع المقطم',
				videoDesktop: '/assets/owner-confirmed/hero/hero-m-mokattam-clean2.mp4',
				videoMobile: '/assets/owner-confirmed/hero/hero-m-mokattam-clean2.mp4',
			},
		] satisfies HeroSlide[],
	},
}[locale];

/**
 * Section and subsection headings. Only owner-approved wording is used:
 * المشاريع الكبرى / مشاريع أخرى with مكتملة and قيد التنفيذ.
 */
const megaHeadings = {
	en: { title: 'Major Projects', completed: 'Completed', inProgress: 'Under construction' },
	ar: { title: 'المشاريع الكبرى', completed: 'مكتملة', inProgress: 'قيد التنفيذ' },
}[locale];

const standardHeadings = {
	en: { title: 'Other Projects', completed: 'Completed', inProgress: 'Under construction' },
	ar: { title: 'مشاريع أخرى', completed: 'مكتملة', inProgress: 'قيد التنفيذ' },
}[locale];
---

<div class="owner-home" data-owner-home data-locale={locale}>
	<header class="owner-nav" aria-label={isArabic ? 'التنقل الرئيسي' : 'Primary navigation'}>
		<div class="owner-container owner-nav__inner">
			<a class="owner-brand" href={isArabic ? '/ar/' : '/en/'} aria-label={content.brand}>
				<img src="/assets/owner-confirmed/brand/logo-primary.png" alt={content.brand} width="85" height="40" />
				<span>{content.brand}</span>
			</a>

			<nav class="owner-nav__links" aria-label={isArabic ? 'روابط الصفحة الرئيسية' : 'Homepage links'}>
				{content.nav.map((item) => <a href={item.href}>{item.label}</a>)}
			</nav>

			<button class="owner-nav__menu" type="button" aria-expanded="false" aria-controls="owner-mobile-drawer" data-owner-menu-toggle>
				<span class="owner-nav__menu-icon" aria-hidden="true"><span></span><span></span></span>
				<span>{content.menu}</span>
			</button>
		</div>
	</header>

	<div id="owner-mobile-drawer" class="owner-drawer" aria-hidden="true" data-owner-drawer>
		<div class="owner-drawer__inner">
			<div class="owner-drawer__header">
				<span>{content.brand}</span>
				<button type="button" data-owner-drawer-close aria-label={content.close}>×</button>
			</div>
			<nav aria-label={isArabic ? 'قائمة الهاتف' : 'Mobile navigation'}>
				{content.nav.map((item, index) => (
					<a class="owner-drawer__link" href={item.href}>
						<span>{String(index + 1).padStart(2, '0')}</span>
						{item.label}
					</a>
				))}
			</nav>
		</div>
	</div>

	<section class="owner-hero" id="hero" aria-label={isArabic ? 'عرض المشاريع الرئيسية' : 'Featured project showcase'} data-owner-hero>
		<div class="owner-container">
			<div class="owner-hero__frame">
				<div class="owner-hero__slides" aria-live="polite">
					{content.slides.map((slide, index) => (
						<article
							class:list={["owner-hero__slide", { 'is-active': index === 0 }]}
							data-owner-hero-slide
							aria-hidden={index === 0 ? 'false' : 'true'}
						>
							{slide.videoDesktop ? (
								<video
									class="owner-hero__video"
									poster={slide.image}
									muted
									playsinline
									preload="metadata"
									aria-label={slide.alt}
									data-owner-hero-video
									data-owner-video-desktop={slide.videoDesktop}
									data-owner-video-mobile={slide.videoMobile ?? slide.videoDesktop}
								>
									<source src={slide.videoDesktop} media="(min-width: 861px)" type="video/mp4" />
									{slide.videoMobile && <source src={slide.videoMobile} media="(max-width: 860px)" type="video/mp4" />}
									<img src={slide.image} alt={slide.alt} width="1440" height="760" loading={index === 0 ? 'eager' : 'lazy'} decoding={index === 0 ? 'sync' : 'async'} />
								</video>
							) : (
								<img src={slide.image} alt={slide.alt} width="1440" height="760" loading={index === 0 ? 'eager' : 'lazy'} decoding={index === 0 ? 'sync' : 'async'} />
							)}
							<div class="owner-hero__caption owner-hero__caption--desktop">
								<div>
									{index === 0
										? <h1><a class="owner-hero__title-link" href={slide.href ?? '#hero'} title={slide.cta}><span>{slide.title}</span><svg class="owner-hero__arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg></a></h1>
										: <h2><a class="owner-hero__title-link" href={slide.href ?? '#hero'} title={slide.cta}><span>{slide.title}</span><svg class="owner-hero__arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg></a></h2>}
								</div>
							</div>
						</article>
					))}
				</div>

				<div class="owner-hero__indicators" role="tablist" aria-label={isArabic ? 'اختيار الشريحة' : 'Choose hero slide'}>
					{content.slides.map((slide, index) => (
						<button
							class:list={["owner-hero__indicator", { 'is-active': index === 0 }]}
							type="button"
							role="tab"
							data-owner-hero-dot={index}
							aria-label={`${isArabic ? 'الشريحة' : 'Slide'} ${index + 1}: ${slide.title}`}
							aria-selected={index === 0 ? 'true' : 'false'}
						>
							<svg class="owner-hero__ring" viewBox="0 0 36 36" aria-hidden="true" focusable="false">
								<circle class="owner-hero__ring-track" cx="18" cy="18" r="16" />
								<circle class="owner-hero__ring-progress" cx="18" cy="18" r="16" pathLength="100" />
							</svg>
							<span class="owner-hero__dot"></span>
						</button>
					))}
				</div>

				<button class="owner-hero__fullscreen" type="button" data-owner-hero-fullscreen aria-pressed="false" aria-label={isArabic ? 'ملء الشاشة' : 'Full screen'}>
					<svg class="owner-hero__fs-enter" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
					<svg class="owner-hero__fs-exit" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
				</button>
			</div>

		</div>
	</section>

	<!-- Data-driven project showcase, one tier heading with two subsections.
		     The earlier hardcoded "Completed Projects" mega block was removed under
		     owner decision D3; its media lived in completed-mega/ and is gone. -->
		<ProjectsShowcase
			locale={locale}
			title={megaHeadings.title}
			label={megaHeadings.completed}
			status="completed"
			scale="mega"
			columns={2}
		/>

		<ProjectsShowcase
			locale={locale}
			title={megaHeadings.title}
			label={megaHeadings.inProgress}
			status="in-progress"
			scale="mega"
			columns={2}
			heading={false}
		/>

		<ProjectsShowcase
			locale={locale}
			title={standardHeadings.title}
			label={standardHeadings.completed}
			status="completed"
			scale="standard"
			columns={3}
		/>

		<ProjectsShowcase
			locale={locale}
			title={standardHeadings.title}
			label={standardHeadings.inProgress}
			status="in-progress"
			scale="standard"
			columns={4}
			heading={false}
		/>

		<!-- Educational Channel: sample placeholders until the owner supplies videos. -->
		<EducationalChannel locale={locale} />

		<!-- The earlier hardcoded "Completed Standard" block was removed under owner
			     decision D3's integration rule: its only card was #9, which is now
			     rendered by the data-driven Normal Completed subsection, so keeping it
			     would show #9 twice on the page. Its production media file
			     completed-standard/project-09-arab-al-yasar.jpg is still the approved
			     image for #9 and is now referenced from src/data/projects.ts. -->

	{locale === 'en' && <SiteFooter />}
</div>

<script define:vars={{ slides: content.slides }}>
	const ownerHome = document.querySelector('[data-owner-home]');

	if (ownerHome instanceof HTMLElement) {
		const drawer = ownerHome.querySelector('[data-owner-drawer]');
		const toggle = ownerHome.querySelector('[data-owner-menu-toggle]');
		const close = ownerHome.querySelector('[data-owner-drawer-close]');
		const drawerLinks = Array.from(ownerHome.querySelectorAll('.owner-drawer__link'));

		const setDrawerOpen = (open) => {
			if (!(drawer instanceof HTMLElement) || !(toggle instanceof HTMLButtonElement)) return;
			drawer.classList.toggle('is-open', open);
			drawer.setAttribute('aria-hidden', String(!open));
			toggle.setAttribute('aria-expanded', String(open));
			document.body.style.overflow = open ? 'hidden' : '';
		};

		if (toggle instanceof HTMLButtonElement) toggle.addEventListener('click', () => setDrawerOpen(!drawer?.classList.contains('is-open')));
		if (close instanceof HTMLButtonElement) close.addEventListener('click', () => setDrawerOpen(false));
		drawerLinks.forEach((link) => link.addEventListener('click', () => setDrawerOpen(false)));
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') setDrawerOpen(false);
		});

		const hero = ownerHome.querySelector('[data-owner-hero]');
		const slideEls = Array.from(ownerHome.querySelectorAll('[data-owner-hero-slide]'));
		const desktopDots = Array.from(ownerHome.querySelectorAll('[data-owner-hero-dot]'));
		const videos = Array.from(ownerHome.querySelectorAll('[data-owner-hero-video]'));
		const mobileVideoQuery = window.matchMedia('(max-width: 860px)');
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		let activeIndex = 0;
		let timer;
		let slideStartedAt = performance.now();

		const configureVideoSource = (video) => {
			if (!(video instanceof HTMLVideoElement)) return;
			const preferred = mobileVideoQuery.matches ? video.dataset.ownerVideoMobile : video.dataset.ownerVideoDesktop;
			if (!preferred) return;
			const preferredUrl = new URL(preferred, window.location.href).href;
			if (video.currentSrc === preferredUrl || video.src === preferredUrl) return;
			video.pause();
			video.src = preferred;
			video.load();
		};

		videos.forEach((video) => {
			if (!(video instanceof HTMLVideoElement)) return;
			video.muted = true;
			video.defaultMuted = true;
			video.playsInline = true;
			video.setAttribute('muted', '');
			video.setAttribute('playsinline', '');
			configureVideoSource(video);
		});

		mobileVideoQuery.addEventListener('change', () => {
			videos.forEach((video) => configureVideoSource(video));
			showSlide(activeIndex);
			startAuto();
		});

		const showSlide = (index) => {
			if (!slideEls.length) return;
			activeIndex = (index + slideEls.length) % slideEls.length;
			slideEls.forEach((slide, slideIndex) => {
				const active = slideIndex === activeIndex;
				slide.classList.toggle('is-active', active);
				slide.setAttribute('aria-hidden', String(!active));
				const video = slide.querySelector('[data-owner-hero-video]');
				if (video instanceof HTMLVideoElement) {
					configureVideoSource(video);
					if (active && !reduceMotion.matches) {
						try {
							video.currentTime = 0;
						} catch (error) {}
						video.play().catch(() => {
							// Keep the poster visible if a browser blocks autoplay.
						});
					} else {
						video.pause();
						try {
							video.currentTime = 0;
						} catch (error) {}
					}
				}
			});
			desktopDots.forEach((dot) => {
				if (!(dot instanceof HTMLElement)) return;
				const dotIndex = Number(dot.dataset.ownerHeroDot ?? 0);
				const active = dotIndex === activeIndex;
				dot.classList.toggle('is-active', active);
				dot.setAttribute('aria-selected', String(active));
			});
			slideStartedAt = performance.now();
			desktopDots.forEach((dot) => dot instanceof HTMLElement && dot.style.setProperty('--progress', '0'));
			// Start loading the next video so the switch feels instant.
			const nextVideo = slideEls[(activeIndex + 1) % slideEls.length]?.querySelector('[data-owner-hero-video]');
			if (nextVideo instanceof HTMLVideoElement && nextVideo.preload !== 'auto') nextVideo.preload = 'auto';
		};

		const stopAuto = () => {
			if (timer) window.clearTimeout(timer);
			timer = undefined;
		};

		const advanceSlide = () => {
			showSlide(activeIndex + 1);
			startAuto();
		};

		const startAuto = () => {
			stopAuto();
			if (reduceMotion.matches) {
				videos.forEach((video) => {
					if (video instanceof HTMLVideoElement) video.pause();
				});
				return;
			}
			const activeVideo = slideEls[activeIndex]?.querySelector('[data-owner-hero-video]');
			if (activeVideo instanceof HTMLVideoElement) {
				activeVideo.play().catch(() => {
					// Poster fallback remains visible if autoplay is unavailable.
				});
				return;
			}
			timer = window.setTimeout(advanceSlide, 6200);
		};

		videos.forEach((video) => {
			if (!(video instanceof HTMLVideoElement)) return;
			video.addEventListener('ended', () => {
				const owningSlide = slideEls.findIndex((slide) => slide.contains(video));
				if (owningSlide === activeIndex && !reduceMotion.matches) advanceSlide();
			});
		});

		desktopDots.forEach((dot) => {
			if (!(dot instanceof HTMLButtonElement)) return;
			dot.addEventListener('click', () => {
				showSlide(Number(dot.dataset.ownerHeroDot ?? 0));
				startAuto();
			});
		});

		// Progress ring: fills as the active video plays, resets on the next slide.
		const tickProgress = () => {
			const dot = desktopDots[activeIndex];
			const video = slideEls[activeIndex]?.querySelector('[data-owner-hero-video]');
			let value = 0;
			if (video instanceof HTMLVideoElement && Number.isFinite(video.duration) && video.duration > 0) {
				value = (video.currentTime / video.duration) * 100;
			} else {
				value = ((performance.now() - slideStartedAt) / 6200) * 100;
			}
			if (dot instanceof HTMLElement) dot.style.setProperty('--progress', String(Math.max(0, Math.min(100, value))));
			window.requestAnimationFrame(tickProgress);
		};
		window.requestAnimationFrame(tickProgress);

		// Full screen: the whole hero (picture, caption, dots) goes full screen, so
		// the slides keep playing and moving on exactly as they do on the page.
		const fsButton = hero?.querySelector('[data-owner-hero-fullscreen]');
		const fsTarget = hero?.querySelector('.owner-hero__frame');
		if (fsButton instanceof HTMLButtonElement && fsTarget instanceof HTMLElement) {
			const isFull = () => document.fullscreenElement === fsTarget || fsTarget.classList.contains('is-pseudo-fullscreen');
			const syncFull = () => {
				const on = isFull();
				fsTarget.classList.toggle('is-fullscreen', on);
				fsButton.setAttribute('aria-pressed', String(on));
			};
			const enterFull = async () => {
				if (fsTarget.requestFullscreen) {
					try {
						await fsTarget.requestFullscreen();
						syncFull();
						return;
					} catch (error) {}
				}
				// Phones that cannot full-screen a page element: fill the window instead.
				fsTarget.classList.add('is-pseudo-fullscreen');
				document.body.style.overflow = 'hidden';
				syncFull();
			};
			const exitFull = () => {
				if (document.fullscreenElement) document.exitFullscreen();
				fsTarget.classList.remove('is-pseudo-fullscreen');
				document.body.style.overflow = '';
				syncFull();
			};
			fsButton.addEventListener('click', () => (isFull() ? exitFull() : enterFull()));
			document.addEventListener('fullscreenchange', syncFull);
			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape' && fsTarget.classList.contains('is-pseudo-fullscreen')) exitFull();
			});
		}

		// Swipe left or right on touch screens to change slide.
		const heroFrame = hero?.querySelector('.owner-hero__frame');
		if (heroFrame instanceof HTMLElement) {
			let startX = 0;
			let startY = 0;
			let tracking = false;
			heroFrame.addEventListener('pointerdown', (event) => {
				if (event.pointerType === 'mouse') return;
				startX = event.clientX;
				startY = event.clientY;
				tracking = true;
			});
			heroFrame.addEventListener('pointercancel', () => {
				tracking = false;
			});
			heroFrame.addEventListener('pointerup', (event) => {
				if (!tracking) return;
				tracking = false;
				const dx = event.clientX - startX;
				const dy = event.clientY - startY;
				if (Math.abs(dx) < 48 || Math.abs(dx) < Math.abs(dy) * 1.4) return;
				const rtl = document.documentElement.dir === 'rtl';
				const forward = rtl ? dx > 0 : dx < 0;
				showSlide(activeIndex + (forward ? 1 : -1));
				startAuto();
			});
		}

		hero?.addEventListener('mouseenter', stopAuto);
		hero?.addEventListener('mouseleave', startAuto);
		hero?.addEventListener('focusin', stopAuto);
		hero?.addEventListener('focusout', startAuto);
		reduceMotion.addEventListener('change', startAuto);
		showSlide(0);
		startAuto();
	}
</script>

<style>
	.owner-home {
		--bg-main: #ffffff;
		--surface-soft: #e8f6fe;
		--surface-soft-border: rgba(8, 145, 178, 0.16);
		--serene-accent: #0891b2;
		--serene-accent-hover: #0e7490;
		--almasa-blue: #003a6b;
		--almasa-blue-hover: #002b50;
		--text-primary: #0f172a;
		--text-secondary: #475569;
